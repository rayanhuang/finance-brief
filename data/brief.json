[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-23", "text": "週一・早報（台股 11/20 收盤、美股 11/20 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "down", "tag": "", "text": "美股 11/20 全面崩跌（那指 −5.28%、費半 −10.73%、輝達 −14%、VIX 35.89），台股週一將補跌，且為「平盤以下禁空」新制首日，今天先看開盤跳空幅度、外資是否續賣與國安基金動向。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/23 09:00", "text": "台股週一開盤——補跌美股費半 −10.7%、台積電 ADR −9.5%，禁空令與國安基金護盤成效；守不守得住 36,000", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/23 22:45", "text": "美國 11 月 S&P Global flash PMI——AI 拋售後景氣與價格分項", "a": "今天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/24 23:00", "text": "美國 Conference Board 消費者信心——消費與就業預期", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "11/25 21:30", "text": "美國 10 月 PCE、Q3 GDP 二次估值——核心 PCE 預期約 3.2%，決定 12 月升息預期", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "11/26 全天", "text": "美國感恩節休市（11/27 美股 13:00 ET 提前收盤，台北 11/28 02:00）——流動性偏低、波動放大", "a": "倒數 3 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/04 21:30（約）", "text": "美國 11 月非農（日期為推算）——薪資與失業率", "a": "倒數 11 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/10 03:00（約）", "text": "FOMC 12 月利率決議（日期為推算）——升息 25bp 機率約 96%（11/19 定價）、點陣圖", "a": "倒數 17 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "down", "tag": "", "text": "美國 10 月 FOMC 紀要（11/18）偏向更多升息，CPI、零售銷售強於預期；市場定價 12 月升息 25bp 機率約 96%。11/20 股災後 10 年期殖利率回落至約 4.93%（避險買盤），但股市仍崩，顯示壓力來自 AI 估值與資本支出疑慮而非單純利率。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "半導體/AI", "text": "美股 11/20 重挫：標普 −3.70% 至 6,910.39（連 7 跌）、那指 −5.28% 至 22,617.73（年內轉負）、費半 −10.73%，輝達 −14%、美光 −13.9%、博通 −12.2%。", "a": "VIX 升至 35.89；殖利率回落，黃金同步走弱。", "b": "", "url": "https://news.cnyes.com/news/id/6669311"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "台灣", "text": "台股 11/20 重挫 2,393.60 點（−6.23%）收 36,033.29，史上第 3 大跌點、單週跌約 17.5%，電子零組件 −9.51%、金融 −5.82%，逾 300 檔跌停；外資賣超 94.13 億，連 5 賣。", "a": "上市市值單週蒸發近 25 兆元。", "b": "", "url": "https://www.peoplenews.tw/articles/investment-financialmgmt/68705"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "台灣", "text": "金管會 11/21 宣布第三波穩市措施、11/23 起：平盤以下禁止放空（融券與借券賣出，適用 1,986 檔）、最低融券保證金成數 130% 調至 150%、暫停券商發行認售權證；國安基金證實已進場護盤。", "a": "短期止血，但外資仍可賣現股；傳融資維持率 130% 降至 120%（待證實）。", "b": "", "url": "https://finance.technews.tw/2026/11/22/total-no-fly-zone"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "半導體/AI", "text": "AI 拋售起因：資本支出回報疑慮、輝達執行長黃仁勳辭任（Kress 暫代）、傳 SEC 調查輝達會計、期中選舉後晶片出口監管疑慮；Anthropic 上市首日漲逾 17% 後次日回吐 8.5%。", "a": "AI、記憶體、光通訊、AI 電力股同步獲利了結。", "b": "", "url": "https://www.nst.com.my/amp/business/corporate/2026/11/1576568/wall-street-ends-lower-nvidia-ceo-resigns-us-yields"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "down", "tag": "加密", "text": "比特幣 11/20 跌破 6 萬美元（約 59,091，來源間有出入），11 月跌幅約 21–23%，為 2022 年 6 月以來最大月跌，現貨 ETF 資金外流。", "a": "恐懼貪婪指數仍處極度恐懼。", "b": "", "url": "https://cryptobriefing.com/bitcoin-falls-23-november-2026-bear-market/"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "資金由風險資產撤向債券與現金：美債殖利率回落、VIX 升至 35.89，股、幣、金同步下跌，屬流動性去槓桿而非單一族群輪動；外資台股連 5 賣、11 月累計賣超約 8,397 億。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝防禦型債券、避險現金；弱勢＝AI 半導體、記憶體、光通訊、AI 電力與電子零組件（費半較 6 月高點跌約 43%）。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "AI 資本支出估值被重新定價＋升息預期疊加，市場進入去槓桿階段，反彈需等待流動性與外資賣壓緩解。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 週一台股開盤跳空與成交量；(2) 外資現股賣超是否收斂；(3) VIX 是否站穩 35 以上或回落；(4) 10 年期殖利率與 12 月升息機率。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "禁空令加國安基金入場，可壓縮空方槓桿、降低跌停連鎖；若美股週一反彈、費半止跌，台股權值可望技術性反彈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "費半 −10.73%、台積電 ADR −9.48%，11/20 台股收盤後才被美股補跌，週一有補跌壓力；外資仍可賣現股，融資斷頭與權值股連動風險仍在。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "美股崩跌 → 費半／輝達重挫 → 台積電、聯發科、電子零組件補跌 → 加權跌破 36,000 後的下一關為 35,739（11/20 盤中低）。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/23 禁空新制首日；11/25 PCE；11/26 美股感恩節休市，美股量能偏低。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：禁空令、國安基金、極度超賣（RSI 低檔、乖離 MA20 約 −15.7%）vs 空方疑慮：美股週五再崩、AI 估值重估、升息預期、外資連續賣超。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "週一台股開盤。多方推演→開盤小幅補跌後量縮止穩、外資賣超收斂，可能技術性反彈至 MA5 約 39,157；空方推演→開盤跳空破 35,739、跌停家數再增，下探 35,000 以下。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：下檔 35,739（盤中低）、36,033（收盤）；上檔 MA5 39,157、MA10 41,119。那指：22,618（收盤低）、MA5 23,953。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤再創新低（低於 36,033）", "a": "收復 MA5 39,157", "b": "觀察中", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "VIX 收盤續高於 35 或費半再單日跌逾 5%", "a": "VIX 回落至 28 以下", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "外資單日賣超逾 500 億，或 10 年期殖利率重回 5.1% 以上", "a": "外資轉買超、殖利率回到 4.9% 以下", "b": "未觸發", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權開低後守住 35,739 且成交量縮、外資賣超收斂→反彈可看 39,157（MA5）", "a": "外資賣超縮至 100 億內、跌停家數大減", "b": "收盤跌破 35,739", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若費半連兩日止跌且 VIX 回落→AI 權值股可望脫離補跌", "a": "VIX 回落至 30 以下", "b": "費半再跌逾 5%", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若 PCE（11/25）高於預期 3.2%→12 月升息確定性升高，成長股估值再承壓", "a": "核心 PCE 高於 3.2%、殖利率回升", "b": "PCE 低於預期", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天最該盯：台股開盤補跌幅度（費半 −10.7% 的傳導）與禁空令首日成交；其次是外資是否續賣、國安基金是否持續護盤，以及晚上 PMI 對美股期貨的影響。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "加權趨勢", "text": "加權 11/20 收 36,033，空頭排列，5 日 −17.50%、20 日 −23.15%，乖離 MA5 −7.98%、MA20 −15.65%，距期間高 −27.7%。", "a": "5日 −17.50%／20日 −23.15%", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股與費半", "text": "那指收 22,618（5 日 −10.02%，乖離 MA20 −9.90%）；費半收 8,409（5 日 −17.13%，距期間高 −36.4%），皆空頭排列。", "a": "那指 −5.28%／費半 −10.73%", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "外資籌碼", "text": "外資連 5 日賣超，近 5 日累計 −2,185.7 億、近 20 日 −10,947.8 億；加權與費半近 20 日報酬相關係數 0.56。", "a": "近5日 −2,186 億", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "比特幣", "text": "BTC 約 59,091（約值），5 日 −9.58%、20 日 −23.79%，距期間高 −30.9%，空頭排列。", "a": "−23.79%（20日）", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期殖利率約 4.93%，近 5 日 −21bp（避險買盤）；新台幣 32.936，近 5 日貶 9.8 分。", "a": "10Y 4.93%／台幣 32.936", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "保守觀望、不追價", "text": "整體以保守為主：週一開盤前不預設反彈，現金優先；若加權收盤收復 MA5（約 39,157）且外資轉買超，再考慮分批（單次不超過可動用資金 1–2 成）；未收復前不加碼、不使用融資。", "a": "依據：加權乖離 MA20 −15.65%（超賣）但仍空頭排列，費半 −10.73% 尚未反映於台股，外資連 5 賣。", "b": "風險與失效：若收盤跌破 35,739 或 VIX 續高於 35，視為續跌訊號，應降低部位；本建議不保證獲利。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "台股 2454、2308、3711 11/20 收盤價沿用前版（已為 11/20 數字，未重新核對）；台指期夜盤、強勢族群、週一開盤預估點位未查到。", "a": "", "b": "", "url": ""}, {"key": "gap-2", "section": "gap", "ord": 2, "tone": "", "tag": "", "text": "美債 30Y、布蘭特、美元指數、ETH、ETF 淨流入、BTC UTC 日收盤查不到：寫 null；WTI、黃金、BTC、10Y 各來源有出入，採用約值。", "a": "", "b": "", "url": ""}, {"key": "gap-4", "section": "gap", "ord": 4, "tone": "", "tag": "", "text": "成交值 8,773 億為單一來源，新台幣 32.936 為 MoneyDJ 口徑而非中央社；FedWatch 機率為 11/19 資料。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "鉅亨網 美股盤後 11/20", "a": "", "b": "", "url": "https://news.cnyes.com/news/id/6669311"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "中天新聞網 台股 11/20 收盤", "a": "", "b": "", "url": "https://ctinews.com/news/items/MyWkM3QGx6"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "科技新報 禁空令與週一展望", "a": "", "b": "", "url": "https://finance.technews.tw/2026/11/22/total-no-fly-zone"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "UDN 美股 11/20", "a": "", "b": "", "url": "https://udn.com/news/story/6811/9893064"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "Closing Print 週收盤摘要", "a": "", "b": "", "url": "https://www.theclosingprint.net/2026/11/post-market-and-weekly-summary-2026-11-20/"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "Yahoo 11/20 新台幣收盤（MoneyDJ）", "a": "", "b": "", "url": "https://tw.stock.yahoo.com/news/11-20%E6%96%B0%E5%8F%B0%E5%B9%A3%E5%85%8C%E7%BE%8E%E5%85%83%E5%8C%AF%E7%8E%87%E4%BB%A532-936%E5%85%83%E4%BD%9C%E6%94%B6-%E5%8D%87%E5%80%BC0-6%E5%88%86-080500471.html"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "Crypto Briefing 比特幣跌破 6 萬", "a": "", "b": "", "url": "https://cryptobriefing.com/bitcoin-falls-23-november-2026-bear-market/"}]