[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-26", "text": "週四・早報（台股 11/25 收盤、美股 11/25 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "down", "tag": "", "text": "台股 11/25 單日重挫 1,927 點（−4.80%）收 38,195，外資連 8 賣、賣超 1,237 億，盤中一度跌近 8%；10 月 PCE 年增 3.8%、核心 3.3% 強化升息預期，今晚美股感恩節休市，12/9 FOMC 與 12/4 非農是下一關。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/26 全天", "text": "美國感恩節休市——美股今晚無交易，台股只能參考期貨與亞股", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/28 02:00", "text": "美股感恩節後半日交易（美東 11/27 13:00 收盤）——量縮，波動可能放大", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "12/04 21:30", "text": "美國 11 月非農就業——就業、失業率、薪資（BLS 兩頁日期有 12/4、12/8 衝突，待確認）", "a": "倒數 8 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/10 03:00", "text": "FOMC 利率決策（12/8–9，含點陣圖，記者會 03:30）——升息幅度與點陣圖", "a": "倒數 14 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/10 21:30", "text": "美國 11 月 CPI——FOMC 後的通膨追蹤（單一來源）", "a": "倒數 14 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/10 前後", "text": "台積電 11 月營收——年增與月增（推算日期，待確認）", "a": "倒數 14 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/18 前後", "text": "台灣央行第 4 季理監事會——利率與匯率政策（依去年日期推算，待確認）", "a": "倒數 22 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "美國 10 月 PCE 物價年增 3.8%、核心 PCE 年增 3.3%（CNBC），市場強化 12 月與 1 月升息預期；Q3 GDP 二次估值實際值未查到。", "a": "PCE 年增 3.8%／核心 3.3%", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "台股大盤", "text": "台股 11/25 收 38,195.43 點、跌 1,926.92 點（−4.80%），盤中低 36,681.90，成交約 1.18 兆；11/24 才大漲約 3,300 點。", "a": "外資賣超 1,236.55 億、投信買超 550.35 億，融資單日增約 197 億；原因含美國將公布對 16 國的關稅調查、費半重挫。", "b": "https://businesstoday.com.tw/article/category/183008/post/202611250010", "url": ""}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "美股／AI", "text": "美股 11/25 道瓊 +0.33%、標普 −0.25%、那指 −0.62%；盤中那指一度重挫逾 4%，尾盤收復；輝達 −3.91%，S&P Global 將其列入信用觀察名單（負向），理由為公司治理疑慮。", "a": "AI 股領跌：甲骨文跌逾 5%、美光跌 4.5%，VIX 升至 28.29。", "b": "https://www.cnbc.com/2026/11/24/stock-market-today-live-updates-.html", "url": ""}, {"key": "news-3", "section": "news", "ord": 3, "tone": "down", "tag": "宏觀／Fed", "text": "美國 10 月 PCE 物價年增 3.8%、核心 PCE 年增 3.3%。", "a": "強化 12 月與 1 月升息預期，壓抑科技股估值；10 年期殖利率 4.848%（−5.6bp）。", "b": "https://www.cnbc.com/2026/11/24/stock-market-today-live-updates-.html", "url": ""}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "匯率", "text": "新台幣 11/25 收 33.126、貶 1.87 角，失守 33 元關卡（單一來源，轉述聯合新聞網）。", "a": "匯銀認為央行讓匯價一次貶到位（業者看法，非央行聲明）；外資今年累計賣超台股近 3.3 兆元。", "b": "https://tw.news.yahoo.com/%E8%82%A1%E5%8C%AF%E9%9B%99%E6%AE%BA-%E5%8F%B0%E8%82%A1%E9%87%8D%E6%8C%AB1926%E9%BB%9E-%E6%96%B0%E5%8F%B0%E5%B9%A3%E9%87%8D%E8%B2%B61-87%E8%A7%92%E5%A4%B1%E5%AE%8833%E5%85%83%E5%A4%A7%E9%97%9C-091303862.html", "url": ""}, {"key": "news-5", "section": "news", "ord": 5, "tone": "mixed", "tag": "台股政策", "text": "金管會鼓勵庫藏股，新增 47 件、連同執行中案件買盤約 630 億元；研議放寬注意股認定，最快年底前上路；融資維持率 11/24 起由 130% 降至 120%。", "a": "11/25 仍大跌，政策未止跌；國安基金等新措施未查到。", "b": "https://udn.com/news/story/7251/9901325", "url": ""}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 8 賣（11/25 −1,236.55 億，近 5 日 −2,367 億），投信 +550 億承接、融資增 197 億，量放大至約 1.18 兆；內資接刀同時槓桿升高，斷頭壓力仍在。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝防禦與醫療、必需消費（美股盤前，單一來源）；弱勢＝AI／半導體（輝達、甲骨文、美光）、台積電等電子權值與金融股。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "升息預期加上 AI 估值修正，台股與費半同步去槓桿；先看外資是否停賣、匯率能否守住 33。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 外資是否轉買或賣超收斂至百億內 (2) 新台幣能否回到 33 以下 (3) VIX 是否回落至 25 以下 (4) 12/4 非農與 12/9 FOMC。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "若 12/4 非農偏弱或 PCE 熱度降溫，升息預期降低，加權可回到 MA5（37,918）之上並挑戰 MA10（39,768）；庫藏股與政策買盤提供底部支撐。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期＋美元強勢＋新台幣破 33，外資持續匯出；AI 估值續修正拖累台積電等權值，融資斷頭可能放大波動。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "美股感恩節休市、無 11/26 隔夜參考；亞股與台指期夜盤為今早主要風向（夜盤數據未取得）。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/28 美股半日市；12/4 非農、12/9 FOMC（12/10 03:00 公布）為接下來的關鍵日程。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：政策買盤（庫藏股、降融資維持率）、投信買超 550 億、盤中低點 36,682 後收回約 1,500 點 vs 空方疑慮：外資連 8 賣、升息預期、新台幣破 33、融資增加、均線空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "12/4 21:30 非農與 12/9 FOMC。多方推演→就業降溫、升息預期收斂，加權站回 MA10 39,768；空方推演→就業偏強、升息確定，加權回測 36,033 低點並可能破底。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 36,682（11/25 盤中低）、36,033（11/20 低）；壓力 37,918（MA5）、39,768（MA10）、41,517（MA20）。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 36,033（11/20 低點）", "a": "收復 MA5 37,918 並站穩", "b": "未觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超逾 300 億且連續賣超", "a": "外資轉買超", "b": "觸發", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "VIX 升破 30 或新台幣貶破 33.5", "a": "VIX 回到 25 以下、新台幣回到 33 以下", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權守住 36,682 並收復 MA5 37,918→ 反彈可挑戰 MA10 39,768", "a": "外資賣超縮至 100 億內、投信續買", "b": "收盤跌破 36,682", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若新台幣續貶破 33.5→ 外資匯出加劇、權值股承壓，台股可能回測 36,033", "a": "新台幣貶破 33.5、外資續賣逾 300 億", "b": "新台幣回到 33 以下", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若 12/4 非農偏弱→ 升息預期降溫、成長股估值回升，費半與台股同步反彈", "a": "10 年期殖利率降破 4.7%、VIX 回落 25 以下", "b": "非農偏強、殖利率續升破 5%", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天最該盯的是外資是否停止賣超與新台幣能否守住 33；美股休市、缺少隔夜指引，開盤後看台積電能否守住 2,150 與融資斷頭壓力。11/25 盤中低 36,682 是短線關鍵價位。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "mixed", "tag": "加權趨勢", "text": "加權 11/25 收 38,195，5 日 −4.97%、20 日 −18.79%，乖離 MA5 +0.73%、MA10 −3.96%、MA20 −8.00%，空頭排列，距期間高 −23.3%。", "a": "5日 −4.97%／20日 −18.79%", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股回吐", "text": "那指 23,586 乖離 MA20 −4.56%、空頭排列；費半 8,775 5 日 −9.10%、乖離 MA20 −10.91%，距期間高 −33.6%。", "a": "費半乖離 MA20 −10.91%", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "比特幣", "text": "BTC 約 60,386，乖離 MA20 −11.80%、20 日 −22.17%，空頭排列，恐懼貪婪指數 13（極度恐懼）；ETF 資金流向未取得。", "a": "20日 −22.17%", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "外資與台股", "text": "外資連 8 日賣超，近 5 日 −2,367 億、近 20 日 −12,240 億；加權與費半近 20 日相關係數 0.29、與那指 0.44，台股獨立波動偏大。", "a": "近20日 −12,240 億", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期 4.848%（5 日 −25bp）、30 年期 5.235%；新台幣 33.126，5 日貶 17.9 分，失守 33。", "a": "新台幣 5 日貶 17.9 分", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "down", "tag": "防守、等訊號", "text": "整體維持防守、不追價：加權仍在空頭排列且外資連 8 賣，建議以現金為主；若加權收盤站回 MA10（約 39,768）且外資轉買超，再分批加碼（單次不超過可動用資金 1–2 成）；不使用融資。", "a": "依據：加權乖離 MA20 −8.00%、外資近 5 日賣超 2,367 億、新台幣破 33、升息預期升溫。", "b": "風險與失效：收盤跌破 36,033 則進一步降低曝險；若非農偏弱且外資連 3 日轉買，反彈可能提前，可小幅試單。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "成交值為約數 1.18～1.19 兆（今周刊／經濟日報）；櫃買指數、台指期夜盤、強弱族群與漲跌停家數、國安基金動向、美債 2Y、BTC／ETH ETF 淨流入、企業國庫動向、Fed 官員發言、加密新聞均查不到；BTC 11/25 UTC 日收盤採 Yahoo 約值；12 月升息機率來源 81～100% 不一致未採用；新台幣 33.126 為單一來源；國際新聞僅 CNBC 單一來源；11/25 Q3 GDP 二次估值實際值未查到；非農、台積電營收、央行日期為推算或有衝突。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "今周刊 台股 11/25 收盤", "a": "", "b": "", "url": "https://businesstoday.com.tw/article/category/183008/post/202611250010"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "經濟日報 台股 11/25 收盤", "a": "", "b": "", "url": "https://udn.com/news/story/7251/9901325"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "CNBC 美股即時 11/25", "a": "", "b": "", "url": "https://www.cnbc.com/2026/11/24/stock-market-today-live-updates-.html"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "Yahoo 奇摩 股匯雙殺、新台幣失守 33", "a": "", "b": "", "url": "https://tw.news.yahoo.com/%E8%82%A1%E5%8C%AF%E9%9B%99%E6%AE%BA-%E5%8F%B0%E8%82%A1%E9%87%8D%E6%8C%AB1926%E9%BB%9E-%E6%96%B0%E5%8F%B0%E5%B9%A3%E9%87%8D%E8%B2%B61-87%E8%A7%92%E5%A4%B1%E5%AE%8833%E5%85%83%E5%A4%A7%E9%97%9C-091303862.html"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "247WallSt 美股 11/25", "a": "", "b": "", "url": "https://247wallst.com/investing/2026/11/25/stock-market-today-huangover-is-causing-headache-for-tech-stocks/"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "CoinLore BTC 歷史", "a": "", "b": "", "url": "http://www.coinlore.com/coin/bitcoin/historical-data"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "BLS 非農公布時程", "a": "", "b": "", "url": "https://www.bls.gov/schedule/news_release/empsit.htm"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "BLS 2026/12 公布時程", "a": "", "b": "", "url": "https://www.bls.gov/schedule/2026/12_sched_list.htm"}, {"key": "source-9", "section": "source", "ord": 9, "tone": "", "tag": "", "text": "Fed FOMC 會議日程", "a": "", "b": "", "url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"}, {"key": "source-10", "section": "source", "ord": 10, "tone": "", "tag": "", "text": "Yahoo Finance、證交所、alternative.me（程式抓取）", "a": "", "b": "", "url": "https://finance.yahoo.com/"}]