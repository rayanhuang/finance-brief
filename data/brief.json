[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-20", "text": "週五・早報（台股 11/19 收盤、美股 11/19 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "升息預期升溫加上 AI 資金撤出，台股單日重挫 4.4% 跌破 4 萬點與年線、美股連 6 黑；今天金管會穩定股市措施上路，反彈力道要看外資是否止賣。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/20 全天", "text": "金管會 5 項穩定股市措施啟動（含恢復有條件限空）——觀察放空限制對台股權值股賣壓的影響", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/23 16:30", "text": "歐美 11 月 flash PMI（美國約 22:45）——製造業與物價分項是否再推高升息預期", "a": "倒數 3 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/24 23:00", "text": "美國 Conference Board 消費者信心——通膨預期與就業分項", "a": "倒數 4 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "11/25 21:30", "text": "美國 10 月 PCE／核心 PCE 與 Q3 GDP 第二次估值——通膨是否支持 12 月升息", "a": "倒數 5 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "11/26 全天", "text": "美國感恩節休市；東京 CPI 11/27 07:30——美股流動性偏低", "a": "倒數 6 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/10 03:00", "text": "FOMC 利率決議與點陣圖——市場約定價升 25 bp（約 90%），留意升 50 bp 可能", "a": "倒數 20 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "10 月 FOMC 紀要偏鷹：幾乎所有官員認為進一步升息恰當，幾位認為 12 月可考慮超過 25 bp，投票 10–2；費城聯銀 11 月指數僅 6.3（預期 20）、物價支付升至 58.2，成長降溫與通膨黏著並存。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "台灣", "text": "加權收 38,426.89，跌 1,768.02 點（−4.40%），史上第 7 大跌點，跌破 4 萬點與年線；下跌 1,014 檔、無類股收紅。", "a": "外資賣超約 243 億，塑化、水泥、機電重挫，PCB 逾 15 檔跌停。", "b": "", "url": "https://www.cna.com.tw/news/afe/202611190149.aspx"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "Fed", "text": "10 月 FOMC 紀要顯示幾乎所有官員支持進一步升息，幾位考慮 12 月升逾 25 bp。", "a": "FedWatch 12 月升 25 bp 約 90%，10Y 殖利率約 5.05%。", "b": "", "url": "https://investinglive.com/central-banks/fomc-minutes-a-couple-of-participants-noted-a-hike-of-more-than-25-bps-could-warrant-consideration-in-december/"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "半導體／AI", "text": "Anthropic（ANT）在那斯達克掛牌，定價 83 美元、首日收 97.17 美元（+17%），募資規模報導稱史上最大 IPO。", "a": "未能撐住大盤：那指 −2.25%、費半 −2.42%，AMD −7.7%（傳中國出口管制曝險）。", "b": "", "url": "https://eurasiabusinessnews.com/2026/11/19/stock-market-today-november-19-2026-dow-sinks-1084-points-nasdaq-drops-2-2-after-anthropic-debut"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "能源", "text": "荷莫茲海峽油輪受阻報導支撐油價，WTI 約 83.2 美元、EIA 商業原油庫存增 340 萬桶。", "a": "油價高檔加深通膨疑慮，不利降息或不升息預期。", "b": "", "url": "https://investinglive.com/news/investinglive-americas-fx-news-wrap-19-nov-inflation-worries-sink-stocks/"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "up", "tag": "台灣", "text": "新台幣 16:00 收 32.942，升 0.5 分，央行出手調節；金管會宣布 11/20 起啟動 5 項穩定股市措施。", "a": "政策面托底，兆豐金等官股金融盤中逆勢。", "b": "", "url": "https://news.cnyes.com/news/id/6667656"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 4 日賣超（累計近 5 日 −1,803 億），主要賣出權值股與主動式 ETF；美債殖利率 5% 以上壓抑成長股估值。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝營建、食品、官股金融、電信（相對抗跌）；弱勢＝塑化、水泥、機電、PCB、半導體權值", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "升息預期推高殖利率、壓低 AI 股估值，台股權值股與外資同步撤退，形成放量殺盤。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 外資是否止賣 (2) 10Y 是否站穩 5% (3) 12/10 FOMC 與 11/25 PCE (4) 金管會限空措施成效", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "金管會穩定股市措施、央行調節匯市、投信連 2 買；若美股止跌，台股有跌深技術反彈空間。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期→殖利率 5%→AI 股估值下修→外資賣台積電與電子權值→加權跌破年線。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "費半 −2.42%、台積電 ADR −2.90%，今日台積電開盤預期仍承壓；台指期夜盤震盪逾 1,800 點，收盤值未查到。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/20 限空措施上路；11/26 美股休市、11/27 提早收盤，週末量能偏低。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：政策托底、跌深乖離大（距 MA20 −11%）、投信買超 vs 空方疑慮：升息預期、外資連賣、技術面空頭排列", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "12 月 FOMC 升息預期。多方推演→PCE 降溫、升息預期回落，殖利率回 5% 以下，外資回補；空方推演→PCE 偏高或升 50 bp，殖利率續創高，AI 股再殺", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：38,426（期間低）支撐、40,686（MA5）壓力、39,368 年線；那指 23,879 為期間低；BTC 6.1 萬附近", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤再跌破 38,426（期間低）", "a": "收復 MA5 40,686", "b": "觀察中", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "10Y 殖利率收盤站上 5.15% 或 FedWatch 升 50 bp 機率逾 25%", "a": "10Y 回到 5.0% 以下", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "外資單日賣超逾 1,000 億或加權單日再跌逾 3%", "a": "外資連 2 日買超", "b": "未觸發", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收復 40,686 且外資轉買→反彈可延伸至 42,000–43,000（MA20 43,262）", "a": "外資單日買超、成交量放大", "b": "再度收低於 38,426", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若 11/25 核心 PCE 高於預期→升 50 bp 機率上升，風險資產再下修", "a": "核心 PCE 月增 ≥0.4%、10Y 破 5.15%", "b": "核心 PCE 低於預期、殖利率回落", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若費半跌破 9,011（期間低）→台積電與 AI 供應鏈續弱", "a": "費半收盤低於 9,011", "b": "費半收復 9,694（MA5）", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天最該盯的是金管會限空措施上路後的盤中量價與外資動向：外資能否止賣、加權能否守住 38,426。晚間留意歐美 PMI（下週一）與美股是否止跌。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "台股", "text": "加權 −4.40% 收 38,426.89，5 日 −10.83%、20 日 −16.99%，跌破 MA20（乖離 −11.18%）、空頭排列，距期間高 −22.9%。", "a": "外資近 5 日累計 −1,803 億", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股", "text": "那指 −2.25% 收 23,879.20、費半 −2.42% 收 9,419.72，均創區間新低、空頭排列；加權與費半 20 日相關係數 0.49。", "a": "費半距高點 −28.7%", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "加密", "text": "BTC 約 61,925，20 日 −19.9%、距高點 −27.6%，乖離 MA20 −13.9%，恐懼貪婪 10。", "a": "空頭排列", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "mixed", "tag": "利率", "text": "10Y 約 5.05%，近 5 日 −8 bp，但仍在高檔；12 月升 25 bp 機率約 90%。", "a": "2Y 4.777%、30Y 5.400%", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "匯率", "text": "新台幣 32.942，近 5 日貶 5.3 分，央行調節後 11/19 轉升 0.5 分。", "a": "外資連賣是貶值壓力來源", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "降低風險、等待訊號再分批", "text": "加權空頭排列、距 MA20 乖離 −11%，建議整體部位以防守為主：不在跌破年線當下追加；若加權收復 40,686（MA5）且外資轉買，再以小部位分批試單，目標 42,000–43,000；現金維持較高比重。", "a": "依據：加權 5 日 −10.83%、外資連 4 賣、10Y 5.05%、升息機率約 90%", "b": "風險：再跌破 38,426 或 PCE／FOMC 超預期偏鷹，應再降部位；反彈若無量，可能是空頭反彈。本建議為情境分析，不保證獲利。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "VIX、布蘭特、美元指數、櫃買指數、台達電與日月光收盤、台指期夜盤收盤、BTC／ETH 現貨 ETF 淨流入未查到（沿用前值或 null）；道瓊跌幅 1,084 與 1,101 點為盤中與收盤之別，採收盤。", "a": "", "b": "", "url": ""}, {"key": "gap-2", "section": "gap", "ord": 2, "tone": "", "tag": "", "text": "BTC 61,925 為 11/20 即時約值，非 UTC 日收盤；10Y 5.05% 為 AP 盤後約值；費半 11/18 為回推估值；FedWatch 機率取自 11/19 09:20 UTC 報導。", "a": "", "b": "", "url": ""}, {"key": "gap-4", "section": "gap", "ord": 4, "tone": "", "tag": "", "text": "輝達執行長狀況、台股放空限制細節、台灣 11/20 盤中、11 月非農與 CPI 確切日期均未驗證。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "中央社 台股收盤 11/19", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611190149.aspx"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "中央社 三大法人 11/19", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611190327.aspx"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "鉅亨網 新台幣收盤", "a": "", "b": "", "url": "https://news.cnyes.com/news/id/6667656"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "自由財經 美股收盤", "a": "", "b": "", "url": "https://ec.ltn.com.tw/article/breakingnews/5647048"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "經濟日報／聯合報 美股與商品", "a": "", "b": "", "url": "https://money.udn.com/money/story/123398/9890421"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "投資直播 FOMC 紀要", "a": "", "b": "", "url": "https://investinglive.com/central-banks/fomc-minutes-a-couple-of-participants-noted-a-hike-of-more-than-25-bps-could-warrant-consideration-in-december/"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "Alternative.me 恐懼貪婪指數", "a": "", "b": "", "url": "https://api.alternative.me/fng/?limit=2"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "CoinLore 加密報價", "a": "", "b": "", "url": "https://api.coinlore.net/api/tickers/?start=0&limit=2"}]