[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-28", "text": "週六・假日新聞版（台股休市，行情為 11/27 收盤）", "a": "holiday", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "美股 11/27 感恩節後半日交易全面反彈（那指 +2.31%、費半 +4.69%），台股 11/27 收 39,308 守穩 3 萬 9，但外資連 10 賣；下週一開盤看 AI 股反彈能否延續，美債殖利率走高仍是變數。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/30 起", "text": "台股新一週開盤，MSCI 相關被動賣壓預期結束——關注外資是否止賣", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "12/4 21:30", "text": "美國 11 月非農就業報告——新增就業、失業率、薪資", "a": "倒數 6 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "12/10 03:00", "text": "FOMC 12 月利率決議（12/9 美東 14:00）與記者會——市場仍計價升息", "a": "倒數 12 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/10 21:30", "text": "美國 11 月 CPI——核心通膨走向", "a": "倒數 12 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/10 前後", "text": "台積電 11 月營收（日期依慣例，未官方確認）", "a": "倒數約 12 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/16 21:30", "text": "美國 11 月 PPI——生產端物價", "a": "倒數 18 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/23 21:30", "text": "美國 PCE 物價（二手日曆，未官方確認）——Fed 偏好的通膨指標", "a": "倒數 25 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "11/27 美股半日交易，無重要美國數據；S&P 500 週漲幅為 19 個月最佳。台股 11/27 籌碼：外資賣超 296.28 億（連 10 賣，賣壓較前一日縮小）、投信買超 85.21 億（連 4 買）、自營商賣超 1.95 億，三大法人合計賣超 213.03 億；成交值 6,946.61 億，量能較前日縮減。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "up", "tag": "美股", "text": "S&P 500 11/27 收 7,297.49（+1.60%）、那指 24,129.50（+2.31%）、道瓊 50,774.94（+1.18%），S&P 500 創 19 個月來最佳單週。", "a": "超跌的科技、半導體、AI 股買盤回流，消費循環股領漲。", "b": "", "url": "https://www.fool.com/coverage/stock-market-today/2026/11/27/stock-market-today-nov-27-s-and-p-500-posts-best-week-in-19-months-as-ai-stocks-rebound/"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "up", "tag": "AI／半導體", "text": "記憶體股自 AI 賣壓強彈：Sandisk 約 +16%、美光 +7.6%，Intel 約 +5%；費半 +4.69% 收 9,186.71。", "a": "晶片股反彈是當天主要上漲動能，對週一台股電子權值有隔夜利多。", "b": "", "url": "https://fool.com/coverage/stock-market-today/2026/11/27/stock-market-today-nov-27-sandisk-surges-16-as-memory-stocks-rebound-from-ai-driven-selloff/"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "能源／貴金屬", "text": "黃金 11/27 大漲（Yahoo 約 3,668.5、+3.75%）；油價來源不一（另有報導稱荷莫茲海峽與沙國設施遭攻擊推升油價，OPEC+ 週日開會），Yahoo 顯示布蘭特 −3.98%。", "a": "避險與通膨題材並存，油價方向需以週一開盤確認。", "b": "", "url": "https://eurasiabusinessnews.com/2026/11/27/u-s-stock-market-today-november-27-2026-tech-rebounds-in-shortened-black-friday-session/"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "mixed", "tag": "台股大盤", "text": "台股 11/27 加權收 39,308.08（+156.27 點、+0.40%），成交值約 6,947 億，週線大漲 3,274 點；尾盤由台積電拉抬。", "a": "量能清淡、週末選舉前觀望，守穩 3 萬 9；散熱、光通訊、低軌衛星受點名。", "b": "", "url": "https://www.cna.com.tw/news/afe/202611270197.aspx"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "down", "tag": "外資動向", "text": "外資 11/27 賣超 296.28 億元，連 10 個交易日賣超，近 10 日累計逾 5,004 億；外資期貨淨空單增至約 10 萬 7,503 口。", "a": "賣壓較前日 491.81 億縮小，但選前調節與高空單讓市場觀望。", "b": "", "url": "https://news.cnyes.com/news/id/6673941"}, {"key": "news-6", "section": "news", "ord": 6, "tone": "mixed", "tag": "匯率", "text": "新台幣 11/27 收 32.935，連 2 升；股匯齊揚，外資同日仍賣超。", "a": "台幣止貶有利穩定情緒，仍看外資動向。", "b": "", "url": "https://news.cnyes.com/news/id/6673973"}, {"key": "news-7", "section": "news", "ord": 7, "tone": "mixed", "tag": "外資分析", "text": "外資今年累計賣超台股逾 3.4 兆元、第四季賣超約 2.11 兆元；MSCI 調升台灣權重至 29.01%，11/30 後相關被動賣壓預期結束。", "a": "分析稿列五項止穩指標：被動賣壓結束、外資減碼趨緩、持股止穩、台幣止貶、晶片營收成長。", "b": "", "url": "https://www.ctee.com.tw/news/20261127700242-439901"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "mixed", "tag": "資金流向", "text": "外資連 9 賣、累計約 4,708 億，投信與主動式 ETF 買盤承接；美債殖利率回落但升息預期未退，資金偏避險。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "mixed", "tag": "板塊輪動", "text": "強勢＝被動元件、PCB、電子權值（台達電 +6.2%、鴻海 +4.8%）；弱勢＝食品（+0.12%）、台積電（−0.23%）與 AI 晶片股落後。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "mixed", "tag": "一句話", "text": "跌深反彈不等於止跌：加權仍在 MA20（41,157）下方，外資沒轉買前反彈偏技術性。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "check", "tag": "觀察指標", "text": "(1) 外資是否轉買超 (2) 加權能否站上 MA10 39,374 並向 MA20 41,157 靠近 (3) VIX 是否回到 25 以下 (4) 新台幣是否守住 33 以內。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "301 調查結果不利空→出口股與權值股風險溢價下降→投信與主動式 ETF 加碼 AI 伺服器與 PCB 供應鏈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期與 AI 股拋售→那指、費半走弱→台積電 ADR 與外資持續賣超→加權反彈受限。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "美股 11/26 休市，11/27 提早收盤；台股 11/27 缺少隔夜美股新訊號，依 11/25 美股偏弱與台股 11/26 反彈的落差評估。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/28 台灣時間凌晨美股提早收盤；12/10 03:00 FOMC 為下一個大事件。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：政策與投信買盤、301 結果不利空、單日漲停 93 家 vs 空方疑慮：外資連 9 賣、升息預期、費半 20 日 −24.9%、均線空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "12/10 03:00 FOMC。多方推演→維持不升息並降低升息暗示，科技股估值回升；空方推演→釋出升息訊號，殖利率與美元走高，外資續賣。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 36,033（11/20 低）、壓力 MA10 39,374／MA20 41,157；那指支撐 22,618、壓力 MA20 24,713。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 36,033（11/20 低點）", "a": "收復 MA5 並站穩 38,063 以上", "b": "未觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超逾 300 億且連續賣超", "a": "外資轉買超", "b": "觸發", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "VIX 升破 30 或新台幣貶破 33.5", "a": "VIX 回到 25 以下、新台幣回到 33 以下", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收盤站上 MA20 41,157 且外資轉買→反彈延續，可提高持股", "a": "外資買超且成交值放大", "b": "再度跌破 38,063（MA5）", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若加權跌破 36,033→風險升級，降低部位、保留現金", "a": "外資單日賣超再逾 500 億", "b": "隔日收復 36,033", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若 VIX 升破 30 或 12/10 FOMC 偏鷹→科技股與台股電子權值承壓", "a": "那指、費半同步創波段新低", "b": "VIX 回到 25 以下", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "11/30（週一）台股開盤先看費半大漲的隔夜效應與外資是否止賣；加權守住 MA5 38,718 才算反彈延續。國際面盯 12/4 非農、12/10 FOMC 與升息預期，以及 OPEC+ 週日會議。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "mixed", "tag": "大盤", "text": "加權 11/27 收 39,308（+0.40%），5 日 +9.09%、20 日 −13.06%，MA5 乖離 +1.52%、MA20 乖離 −3.80%，仍空頭排列。", "a": "MA20 40,861；低點 36,033", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "籌碼", "text": "外資連 10 賣，近 5 日累計 −2,818 億，近 20 日 −11,215 億；投信連 4 買承接。", "a": "今日外資 −296.28 億", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "mixed", "tag": "美股", "text": "那指 11/27 收 24,129.5（20 日 −7.85%）、費半 9,186.7（20 日 −20.24%），仍空頭排列但單日強彈；VIX 23.81。", "a": "費半 +4.69%", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "比特幣", "text": "BTC 約 59,831，20 日 −21.26%，MA20 乖離 −10.24%，恐懼貪婪指數 12（極度恐懼）。", "a": "Yahoo 約值", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期 4.936%（Yahoo，他源約 4.89%）、30 年期 5.325%，利率走高；新台幣 32.935，近 5 日貶 0.1 分。", "a": "DXY 104.0", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "台股逢反彈降低風險、不追高", "text": "整體操作：維持偏低持股，加權反彈至 MA20 40,861 區可分批減碼或不加碼；收盤站上 40,861 且外資轉買才恢復加碼；收破 36,033 再降一級部位。", "a": "依據：加權空頭排列、距 MA20 −3.80%、外資連 10 賣；美股雖強彈但仍空頭排列。", "b": "風險與失效：外資止賣且費半續強使加權站上 MA20，則降風險過早；殖利率續升或升息預期升溫則提前降低部位。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "mixed", "tag": "", "text": "櫃買收盤、台指期夜盤、新台幣 16:00 官方收盤（採鉅亨網 32.935）、美債 2Y（盤中單一來源）、FedWatch、BTC／ETH ETF 淨流入未查到（null）；10 年期殖利率 Yahoo 4.936、他源 4.89，採 Yahoo；油價各來源方向不一，採 Yahoo；BTC 為 Yahoo 約值。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "中央社 台股收盤", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611270197.aspx"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "鉅亨網 外資期貨", "a": "", "b": "", "url": "https://news.cnyes.com/news/id/6673941"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "鉅亨網 新台幣收盤", "a": "", "b": "", "url": "https://news.cnyes.com/news/id/6673973"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "工商時報 外資分析", "a": "", "b": "", "url": "https://www.ctee.com.tw/news/20261127700242-439901"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "Motley Fool 美股收盤", "a": "", "b": "", "url": "https://www.fool.com/coverage/stock-market-today/2026/11/27/stock-market-today-nov-27-s-and-p-500-posts-best-week-in-19-months-as-ai-stocks-rebound/"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "證交所 BFI82U 三大法人", "a": "", "b": "", "url": "https://www.twse.com.tw/rwd/zh/fund/BFI82U?type=day&dayDate=20261127&response=json"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "聯準會 FOMC 日程", "a": "", "b": "", "url": "https://www.federalreserve.gov/newsevents/2026-December.htm"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "BLS 12 月發布時程", "a": "", "b": "", "url": "https://www.bls.gov/schedule/2026/12_sched_list.htm"}, {"key": "source-9", "section": "source", "ord": 9, "tone": "", "tag": "", "text": "Yahoo Finance、證交所、alternative.me（程式抓取）", "a": "", "b": "", "url": ""}]