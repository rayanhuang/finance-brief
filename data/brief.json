[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-27", "text": "週五・早報（台股 11/26 收盤、美股 11/25 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "台股 11/26 跌深反彈 956 點收 39,152，但外資連 9 賣、仍在 20 日線下；美股 11/26 感恩節休市，AI 股拋售與升息預期仍是壓力。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/28 02:00", "text": "美股感恩節後提早收盤——關注假期量縮下的 AI 股與 VIX 波動", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "12/4 21:30", "text": "美國 11 月非農就業報告——新增就業、失業率、薪資（BLS 頁面日期不一致，另有 12/8 說法，待確認）", "a": "倒數 7 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "12/10 03:00", "text": "FOMC 12 月利率決議（12/9 美東 14:00）與點陣圖——市場仍計價升息", "a": "倒數 13 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/10 21:30", "text": "美國 11 月 CPI——核心通膨走向", "a": "倒數 13 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/10 前後", "text": "台積電 11 月營收——10 月 5,868.9 億元、年增 59.7%（日期依慣例，未官方確認）", "a": "倒數約 13 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/16 21:30", "text": "美國 11 月 PPI——生產端物價", "a": "倒數 19 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12 月中旬", "text": "台灣央行第 4 季理監事會——利率與匯率（確切日期未查到）", "a": "倒數約 3 週", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "美國感恩節休市，無重要美國數據。台股 11/26 籌碼：外資賣超 491.81 億（連 9 賣，累計約 4,708 億）、投信買超 212.13 億、自營商買超 128.65 億，上市櫃漲 1,739 家、漲停 93 家，成交 8,175 億元。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "up", "tag": "台股大盤", "text": "11/26 加權收 39,151.81、漲 956.38 點（+2.5%），盤中高 39,459.95；中央社歸因於美國 301 條款調查結果緩解疑慮。", "a": "跌深反彈；外資仍賣超 491.81 億，買盤集中在投信與主動式 ETF，指數仍在年線下。", "b": "", "url": "https://www.cna.com.tw/news/afe/202611260262.aspx"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "up", "tag": "台股族群", "text": "被動元件與 PCB 股領軍反彈，多檔漲停；八大類股皆漲，上市櫃漲停 93 家。", "a": "電子股領漲，但標準型被動元件自 7 月高點仍大幅回跌，屬跌深反彈。", "b": "", "url": "https://money.udn.com/money/story/5710/9903264"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "匯率", "text": "新台幣 11/26 收 32.947，升 1.79 角；出口商拋匯、美 301 結果緩解疑慮，外資仍賣超。", "a": "升值減輕貶值壓力，但外資連 9 賣，匯價仍看外資動向。", "b": "", "url": "https://www.cna.com.tw/news/afe/202611260185.aspx"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "AI／半導體", "text": "11/25 輝達收跌約 4%（前日已跌 6%），AI 與晶片股拋售延續；VIX 盤中一度 35、收 28.29。", "a": "那指 −0.62%、費半 −0.65%，盤中跌幅大幅收復。（發布略超過 24 小時）", "b": "", "url": "https://finance.yahoo.com/markets/stocks/articles/stock-market-today-futures-plunge-133240343.html"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "mixed", "tag": "利率", "text": "10 年期美債殖利率降至約 4.85%，但交易員仍計價 Fed 升息，即使通膨數據符合預期。", "a": "殖利率回落有利成長股，但升息預期壓抑估值。", "b": "", "url": "https://finance.yahoo.com/markets/stocks/articles/stock-market-today-futures-plunge-133240343.html"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "mixed", "tag": "資金流向", "text": "外資連 9 賣、累計約 4,708 億，投信與主動式 ETF 買盤承接；美債殖利率回落但升息預期未退，資金偏避險。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "mixed", "tag": "板塊輪動", "text": "強勢＝被動元件、PCB、電子權值（台達電 +6.2%、鴻海 +4.8%）；弱勢＝食品（+0.12%）、台積電（−0.23%）與 AI 晶片股落後。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "mixed", "tag": "一句話", "text": "跌深反彈不等於止跌：加權仍在 MA20（41,157）下方，外資沒轉買前反彈偏技術性。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "check", "tag": "觀察指標", "text": "(1) 外資是否轉買超 (2) 加權能否站上 MA10 39,374 並向 MA20 41,157 靠近 (3) VIX 是否回到 25 以下 (4) 新台幣是否守住 33 以內。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "301 調查結果不利空→出口股與權值股風險溢價下降→投信與主動式 ETF 加碼 AI 伺服器與 PCB 供應鏈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期與 AI 股拋售→那指、費半走弱→台積電 ADR 與外資持續賣超→加權反彈受限。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "美股 11/26 休市，11/27 提早收盤；台股 11/27 缺少隔夜美股新訊號，依 11/25 美股偏弱與台股 11/26 反彈的落差評估。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/28 台灣時間凌晨美股提早收盤；12/10 03:00 FOMC 為下一個大事件。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：政策與投信買盤、301 結果不利空、單日漲停 93 家 vs 空方疑慮：外資連 9 賣、升息預期、費半 20 日 −24.9%、均線空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "12/10 03:00 FOMC。多方推演→維持不升息並降低升息暗示，科技股估值回升；空方推演→釋出升息訊號，殖利率與美元走高，外資續賣。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 36,033（11/20 低）、壓力 MA10 39,374／MA20 41,157；那指支撐 22,618、壓力 MA20 24,713。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 36,033（11/20 低點）", "a": "收復 MA5 並站穩 38,063 以上", "b": "未觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超逾 300 億且連續賣超", "a": "外資轉買超", "b": "觸發", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "VIX 升破 30 或新台幣貶破 33.5", "a": "VIX 回到 25 以下、新台幣回到 33 以下", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收盤站上 MA20 41,157 且外資轉買→反彈延續，可提高持股", "a": "外資買超且成交值放大", "b": "再度跌破 38,063（MA5）", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若加權跌破 36,033→風險升級，降低部位、保留現金", "a": "外資單日賣超再逾 500 億", "b": "隔日收復 36,033", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若 VIX 升破 30 或 12/10 FOMC 偏鷹→科技股與台股電子權值承壓", "a": "那指、費半同步創波段新低", "b": "VIX 回到 25 以下", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "11/27 台股缺少隔夜美股訊號，先看外資是否止賣與加權能否守住 MA5 38,063。國際面盯美股提早收盤、VIX 與升息預期。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "mixed", "tag": "大盤", "text": "加權 11/26 收 39,152（+2.5%），5 日 +1.89%、20 日 −15.56%，MA5 乖離 +2.86%、MA20 乖離 −4.87%，空頭排列但出現反彈。", "a": "MA20 41,157；低點 36,033", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "籌碼", "text": "外資連 9 賣，近 5 日累計 −2,616 億，近 20 日 −12,044 億；投信、自營買超承接。", "a": "今日外資 −491.81 億", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "美股", "text": "那指 11/25 收 23,586（20 日 −11.2%）、費半 8,775（20 日 −24.9%），均空頭排列；11/26 休市。", "a": "VIX 28.29", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "比特幣", "text": "BTC 約 60,474，20 日 −24.9%，低於 MA20 乖離 −10.4%，恐懼貪婪指數 11（極度恐懼）。", "a": "CoinLore 11/25 收 60,501", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期 4.85%，近 5 日 −25 基點；新台幣 32.947，近 5 日貶 0.5 分，介於 33 附近。", "a": "美債 30Y 5.235%", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "台股逢反彈降低風險、不追高", "text": "整體操作：維持偏低持股，加權反彈至 MA10 39,374～MA20 41,157 區可分批減碼或不加碼；收盤站上 41,157 且外資轉買才恢復加碼；收破 36,033 再降一級部位。", "a": "依據：加權空頭排列、距 MA20 −4.87%、外資連 9 賣、費半 20 日 −24.9%。", "b": "風險與失效：外資轉買超並放量站上 MA20、或 12/10 FOMC 轉鴿，空頭判斷失效；非投資建議，不保證獲利。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "mixed", "tag": "", "text": "櫃買收盤、台指期夜盤、美債 2Y、FedWatch、BTC／ETH ETF 淨流入未查到或互相矛盾（列為 null）；11/26 美股休市，VIX 以 11/25 收盤 28.29 為準，Yahoo 顯示 26.8 不採用。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "Yahoo Finance 美股盤勢", "a": "", "b": "", "url": "https://finance.yahoo.com/markets/stocks/articles/stock-market-today-futures-plunge-133240343.html"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "中央社 台股收盤", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611260262.aspx"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "中央社 新台幣收盤", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611260185.aspx"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "經濟日報 被動元件", "a": "", "b": "", "url": "https://money.udn.com/money/story/5710/9903264"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "聯合新聞網 台股盤後", "a": "", "b": "", "url": "https://udn.com/news/story/7251/9903771"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "聯準會 FOMC 日程", "a": "", "b": "", "url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "BLS 12 月發布時程", "a": "", "b": "", "url": "https://www.bls.gov/schedule/2026/12_sched.htm"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "CoinLore BTC 歷史", "a": "", "b": "", "url": "http://www.coinlore.com/coin/bitcoin/historical-data"}, {"key": "source-9", "section": "source", "ord": 9, "tone": "", "tag": "", "text": "台積電 10 月營收", "a": "", "b": "", "url": "https://pr.tsmc.com/system/files/newspdf/attachment/b3432e75c40fa2efc280463a53d53efe833a81cb/October%202026%20%28C%29_Final_wmn.pdf"}, {"key": "source-10", "section": "source", "ord": 10, "tone": "", "tag": "", "text": "Yahoo Finance、證交所、alternative.me（程式抓取）", "a": "", "b": "", "url": ""}]