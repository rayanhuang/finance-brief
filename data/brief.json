[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-21", "text": "週六・假日新聞版（台股休市，行情為 11/20 收盤）", "a": "holiday", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "美股 11/20 重挫：那指 −5.28%、標普 −3.70% 進入修正、輝達 −14%、VIX 35.89，10Y 殖利率回落至 4.92%；週一台股在限空新制下面臨此一利空，開盤前先看 AI 權值與外資動向。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/23 09:00", "text": "台股週一開盤——承接美股 11/20 重挫，限空新制下的量價與外資動向", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/23 全天", "text": "歐美 11 月 flash PMI（時間待確認）——物價分項是否再推高升息預期", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/24 全天", "text": "美國 Conference Board 消費者信心、Richmond Fed——通膨預期與就業分項", "a": "倒數 3 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "11/25 約 21:30", "text": "美國 10 月 PCE／核心 PCE、Q3 GDP 第二次估值（時間未證實）——核心 PCE 預期月增 0.3%，高於預期則 12 月升 2 碼風險上升", "a": "倒數 4 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "11/26 全天", "text": "美國感恩節休市；南韓央行預期升息 1 碼；美股 11/27 提早收盤、流動性偏低", "a": "倒數 5 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "11/29 全天", "text": "OPEC+ 討論 2027 年產量——油價（布蘭特約 92.6）走向", "a": "倒數 8 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/10 早上", "text": "FOMC 利率決議與點陣圖（12/8–9）——升 1 碼為基本情境（約 97–99%）、升 2 碼約 10%", "a": "倒數 19 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "上週（11/16–20）美國數據：10 月零售 +0.2%、核心 +0.6%（均優於預期），製造業調查大幅低於預期（紐約 7.8、費城 6.3），密大 1 年期通膨預期 3.7%；Fed 官員 Cook、Waller 等偏鷹，12 月升 1 碼機率約 97–99%。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "半導體／AI", "text": "輝達 11/20 重挫 14.01%，路透報導 SEC 執法人員正調查其會計處理，科技類股 −7.27%。", "a": "那指 −5.28%、標普 −3.70% 進入修正，VIX 升至 35.89。", "b": "", "url": "https://cappnotes.substack.com/p/closing-look-friday-november-20-2026"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "Fed", "text": "Cook 稱政策仍不夠緊、等待恐落後曲線；Waller 主張更積極，Warsh 少給明確指引。", "a": "12 月升 1 碼為基本情境（約 97–99%），升 2 碼約 10%；殖利率 10Y 收 4.92%（−12bp）。", "b": "", "url": "https://au.investing.com/news/stock-market-news/fed-signals-and-data-what-happened-the-week-of-nov-1620-2026-93CH-4787356"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "down", "tag": "台灣", "text": "加權 11/20 收 36,033（−6.23%），史上第 3 大跌點，單週逾 −17%，約 365 檔跌停；限空令 2.0 未能止跌，金管會再度喊話。", "a": "恐慌賣壓；自營商避險賣壓放大波動。", "b": "", "url": "https://udn.com/news/story/7251/9891475"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "加密", "text": "BTC 11/20 跌破 6 萬美元（約 58,994，−4.7%），為 7 月以來首次；11/19 貝萊德現貨 BTC ETF 流出 5.41 億美元。", "a": "加密與科技股同步下殺，多單爆倉為主。", "b": "", "url": "https://nexo.com/blog/markets-today-november-20"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "mixed", "tag": "能源", "text": "布蘭特約 92.6、WTI 約 84（均小漲），OPEC+ 11/29 開會討論 2027 年產量；美元指數接近 19 個月高點、黃金走弱。", "a": "股市下跌但油價偏強，通膨疑慮未解。", "b": "", "url": "https://www.nst.com.my/amp/business/corporate/2026/11/1576568/wall-street-ends-lower-nvidia-ceo-resigns-us-yields"}, {"key": "news-6", "section": "news", "ord": 6, "tone": "mixed", "tag": "半導體／AI", "text": "輝達執行長黃仁勳傳於 11/13 前後請辭（傳）；輝達 11/17 財報營收 1,158 億美元（+103%）、Q4 財測約 1,300 億，但股價仍跌。", "a": "AI 題材降溫；以上多為單一來源，需再查證。", "b": "", "url": "https://www.ibtimes.com/us-stocks-dow-falls-nvidia-earnings-fed-rate-hikes-3809938"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 5 賣、近 5 日累計 −2,186 億，期貨淨空約 9.8 萬口；自營商避險賣壓 290 億是今日最大單一賣壓，投信也轉賣。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝雲端資安概念；弱勢＝半導體／AI 供應鏈、ABF 載板、PCB、散熱、CPO", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "美股 AI 股走弱與升息預期傳導到台股權值，再被期貨與避險賣壓放大成恐慌殺盤。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 外資是否止賣 (2) 10Y 是否站穩 5% (3) 12/10 FOMC 與 11/25 PCE (4) 金管會限空措施成效", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "國安基金表態護盤、金管會限空新制；若美股今晚止跌，下週一有跌深技術反彈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期→殖利率 5%→AI 估值下修→外資與自營商避險賣壓→368 檔跌停→流動性風險。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "日股早盤 −4.5%、韓股 −3.5%，亞股同步重挫；美股期貨與台指期夜盤收盤未查到。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "今晚美東 11/20 美股；11/23 台股週一開盤；11/25 PCE。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：國安基金與限空新制托底、乖離 MA20 −15.7% 極度超跌 vs 空方疑慮：外資連 5 賣、期貨空單約 9.8 萬口、跌停潮造成流動性風險", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "週末美股 11/20 大跌後的連動。多方推演→限空新制與國安基金週一奏效、技術反彈；空方推演→美股重挫（那指 −5.28%）＋輝達 −14% 衝擊 AI 供應鏈，週一續殺、跌停潮延續", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：35,739（今日盤中低）支撐、36,000 整數關卡、39,157（MA5）壓力、39,368 年線；費半 9,011（期間低）", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤再跌破 35,739（今日盤中低）", "a": "收復 MA5 39,157", "b": "觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "10Y 殖利率收盤站上 5.15% 或 FedWatch 升 50 bp 機率逾 25%", "a": "10Y 回到 5.0% 以下", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "外資單日賣超逾 1,000 億或加權單日再跌逾 3%", "a": "外資連 2 日買超", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收復 39,157（MA5）且外資轉買→反彈可延伸至 40,686–42,000", "a": "外資單日買超、成交量放大", "b": "再度收低於 36,000", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若 11/25 核心 PCE 高於預期→升 50 bp 機率上升，風險資產再下修", "a": "核心 PCE 月增 ≥0.4%、10Y 破 5.15%", "b": "核心 PCE 低於預期、殖利率回落", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若費半跌破 9,011（期間低）→台積電與 AI 供應鏈續弱", "a": "費半收盤低於 9,011", "b": "費半收復 9,694（MA5）", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "週一開盤前盯：美股期貨是否止跌、輝達 SEC 調查後續、限空新制下加權能否守住 35,739（11/20 盤中低）。11/25 核心 PCE 是 12 月升 2 碼風險的關鍵。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "台股", "text": "加權 −6.23% 收 36,033.29，5 日 −17.50%、20 日 −23.15%，MA20 乖離 −15.65%、空頭排列，距期間高 −27.7%。", "a": "外資近 5 日累計 −2,186 億；成交值約 8,788 億", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股", "text": "那指 −2.25% 收 23,879.20、費半 −2.42% 收 9,419.72，均創區間新低、空頭排列；加權與費半 20 日相關係數 0.49。", "a": "費半距高點 −28.7%；VIX 28.4（+15.8%）", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "加密", "text": "BTC 11/19 UTC 收 62,007，20 日 −19.8%、距高點 −27.5%，乖離 MA20 −13.8%；現貨約 61,842，恐懼貪婪 12（極度恐懼）。", "a": "空頭排列；BTC ETF 11/13 當週 −10.7 億美元", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "mixed", "tag": "利率", "text": "10Y 約 5.05%，近 5 日 −8 bp 但仍在高檔；紀要偏鷹，市場多已計入 12 月升 25 bp。", "a": "30Y 5.401%；2Y 11/19 未查到", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "匯率", "text": "新台幣 Yahoo 即時約 32.969，近 5 日貶約 13 分，外資連賣是貶值壓力來源。", "a": "非 16:00 官方收盤", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "嚴控風險、不接刀", "text": "加權 5 日 −17.5%、乖離 MA20 −15.7%，崩跌期間不攤平、不借錢進場；現金維持高比重。若加權收復 39,157（MA5）且外資轉買，才以小部位分批試單，目標 40,686–42,000；若收盤再破 35,739 則續降部位。", "a": "依據：加權單週 −17.5%、368 檔跌停、外資連 5 賣、期貨淨空約 9.8 萬口", "b": "風險：跌深反彈可能很快、也可能因流動性不足續殺；PCE／FOMC 偏鷹會再壓估值。本建議為情境分析，不保證獲利。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "假日版：美股 11/20 收盤（那指 −5.28%、標普 −3.70%、道瓊 −1.93%）與 BTC 約 58,994 為單一來源（cappnotes／Nexo），費半 11/20 收盤查不到，history／snapshot 的美股與 BTC 欄位待下一個交易日補上；日曆時間多為推估。", "a": "", "b": "", "url": ""}, {"key": "gap-2", "section": "gap", "ord": 2, "tone": "", "tag": "", "text": "輝達 SEC 調查、黃仁勳請辭、Anthropic IPO 等為單一來源，國安基金 11/20 動向未查到；PCE 發布時間 21:30 未證實。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "Closing Look 11/20（美股收盤）", "a": "", "b": "", "url": "https://cappnotes.substack.com/p/closing-look-friday-november-20-2026"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "Investing.com 週回顧", "a": "", "b": "", "url": "https://au.investing.com/news/stock-market-news/fed-signals-and-data-what-happened-the-week-of-nov-1620-2026-93CH-4787356"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "Nexo Markets Today 11/20", "a": "", "b": "", "url": "https://nexo.com/blog/markets-today-november-20"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "Newsquawk 下週重點", "a": "", "b": "", "url": "https://www.newsquawk.com/headlines/week-in-focus--november-23rd-27th-highlights-include-us-pce-flash-pmis-aussie-cpi-and-ecb-minutes"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "聯合新聞網 台股收盤", "a": "", "b": "", "url": "https://udn.com/news/story/7251/9891475"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "Yahoo Finance、證交所、alternative.me（程式抓取）", "a": "", "b": "", "url": ""}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "Yahoo 股市 加權指數", "a": "", "b": "", "url": "https://tw.stock.yahoo.com/quote/%5ETWII"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "CoinLore BTC 歷史", "a": "", "b": "", "url": "https://www.coinlore.com/coin/bitcoin/historical-data"}]