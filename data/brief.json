[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-24", "text": "週二・盤中版（台股 11/24 盤中、美股 11/23 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "mixed", "tag": "", "text": "台股 11/24 盤中漲約 9% 至 40,100 一帶（昨收 36,812，台積電、聯發科、台達電等權值亮燈），但屬盤中數字且外資連 6 賣、12 月升息機率近 98%，先看收盤能否站穩 MA5（約 38,312）。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/24 晚間", "text": "美國消費者信心、Case-Shiller 與 5 年期公債標售——關注標售需求與 10 年期 4.9% 一帶（時間待核對）", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/25 21:30", "text": "美國 10 月 PCE／個人所得與 Q3 GDP 第二次預估——核心 PCE 預期月增 0.3%，影響 12 月升息定價", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/26", "text": "美國感恩節休市，11/27 美股提早收盤（待核對）——美股量縮", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/1 23:00", "text": "美國 10 月 JOLTS——勞動需求是否降溫", "a": "倒數 7 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/4 21:30", "text": "美國 11 月非農與失業率——薪資與失業率，影響 12/9 決策", "a": "倒數 10 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/10 03:00", "text": "FOMC 決議（會期 12/8–9，美東 12/9 14:00）——升息 25bp 機率約 93–98%，看鷹派程度與點陣圖", "a": "倒數 16 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/10 21:30", "text": "美國 11 月 CPI——通膨約 3.5%，核心是否降溫", "a": "倒數 16 天", "b": "", "url": ""}, {"key": "calendar-8", "section": "calendar", "ord": 8, "tone": "", "tag": "12/15 21:30", "text": "美國 11 月 PPI——上游通膨", "a": "倒數 21 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "mixed", "tag": "", "text": "紐約聯準銀行總裁 Williams 表示通膨（約 3.5%）仍有工作要做，不排除連續升息；12 月升息 25bp 機率約 98%（上週五約 88–91%），2 年期殖利率盤中 +7bp、美元指數升至 104.3 的 19 個月高點。輝達 11/17 財報營收 1,158 億美元、優於預期，Q4 財測 1,300 億美元。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "up", "tag": "半導體/AI", "text": "輝達董事會讓黃仁勳回任執行長，輝達單日 +31.5%（2003 年以來最大），美光 +19%、應材 +14.6%、台積電 ADR +14.1%。", "a": "那指 +6.51%、費半 +14.03%，標普終止連 7 黑；VIX 回落至約 26.6。", "b": "", "url": "https://ec.ltn.com.tw/article/breakingnews/5651136"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "Fed", "text": "紐約聯準銀行 Williams 稱通膨仍高、可能連續升息；12 月升息機率約 98%。", "a": "2 年期殖利率盤中 +7bp，美元指數 +0.5% 至約 104.3；歐洲央行、英國央行官員也偏鷹。", "b": "", "url": "https://www.cnbc.com/2026/11/23/treasury-yields-bonds-fed.html"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "台灣", "text": "台股 11/24 盤中約 40,123（+8.99%，11:14 約值），台積電 2,230、聯發科 4,050、台達電 1,085 皆約漲 10%；11/23 +778.60 點收 36,811.89，終止連 7 黑。", "a": "11/23 外資賣超 289.48 億（連 6 賣）、三大法人合計賣超 511.77 億；盤中數字非收盤；11/23 反彈背景含國安基金進場與金管會限空令。", "b": "", "url": "https://news.cts.com.tw/cna/money/202611/202611233104268.html"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "up", "tag": "能源", "text": "布蘭特約 88 美元（−4%）、WTI 約 80 美元（−3.5%），因中東出口恢復與供給過剩預期。", "a": "有助緩和通膨壓力；黃金反彈約 2.7% 至 3,634 美元。", "b": "", "url": "https://finwire.io/news/forex-news/financial-forex-market-recap-nov-23-2026"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "mixed", "tag": "加密", "text": "比特幣 11/23 UTC 日收盤 61,270，11/24 盤中約 59,550（−2.6%）；恐懼貪婪指數 11（極度恐懼）；現貨 ETF 11/20 單日淨流出約 6.7 億美元。", "a": "風險情緒隨美股反彈回穩，但資金流仍偏流出。", "b": "", "url": "https://www.capitalstreetfx.com/market-analysis/daily-crypto-report-23-nov-2026/"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "風險資產由超賣反彈，輝達領頭、記憶體與 PCB 族群漲停；但外資台股連 6 賣、近 5 日累計賣超約 1,773 億，反彈偏技術性，尚未見資金回流。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝電子（+2.85%）、記憶體、PCB、聯發科、台達電；弱勢＝金融（−2.65%）、鴻海（−1.9%）。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "輝達領軍的反彈解除了 AI 恐慌，但升息 98% 定價與外資賣壓仍壓著估值，空頭排列未解除。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 加權能否收復 MA5 38,312；(2) 外資是否由賣轉買；(3) 美國 10 年期殖利率是否守在 5% 下；(4) 11/25 核心 PCE。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "費半 +14%、輝達 +31%、台積電 ADR +14% 傳導台積電、聯發科、記憶體與 PCB 族群；夜盤收 39,829 暗示開盤大幅跳空。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息近 98% 與美元走強壓抑外資回流；外資連 6 賣，跳空後若量縮可能拉回回補缺口。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "夜盤 +3,170 點僅 2 個來源且成交薄；加權 11/23 已先 +2.16%，美股 +4.7～6.5% 的差距可能已部分反映，開盤追價風險高。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/25 PCE、11/26 美股休市；台灣 12/10 前後台積電 11 月營收；平盤以下禁空與護盤措施是否延續待確認。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：美股與費半暴力反彈、輝達執行長回任、夜盤大漲、極度超賣 vs 空方疑慮：升息 98% 定價、美元 19 個月高點、外資連 6 賣、均線仍空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "11/25 核心 PCE 與 12/9 FOMC。多方推演→PCE 持平或偏低、升息預期降溫，反彈延伸至 MA5 38,312 以上；空方推演→PCE 偏高、連續升息論調增強，反彈在 MA5～MA10（40,634）受壓。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 36,033（11/20 低）、35,442（11/23 盤中低）；壓力 38,312（MA5）、40,634（MA10）、42,258（MA20）。那指壓力 24,489（MA10）。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 36,033", "a": "收復 MA5 38,312", "b": "觀察中", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超再逾 300 億且連 7 賣", "a": "外資轉買超", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "VIX 回升至 35 以上或費半跌破 8,409", "a": "VIX 回到 25 以下", "b": "未觸發", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權跳空開高後量能放大且收復 38,312（MA5）→ 反彈可看 40,634（MA10）", "a": "外資賣超縮至 100 億內、電子權值續強", "b": "收盤跌回 36,033 下", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若核心 PCE 高於預期→ 殖利率與美元走強、成長股估值承壓，台股回測 36,000", "a": "10 年期上升逾 5bp、DXY 突破 104.5", "b": "殖利率回落、DXY 回到 103.5 下", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若比特幣守住 59,091（11/20 低）→ 區間 60–65k 震盪", "a": "恐懼貪婪回升至 20 以上、ETF 轉淨流入", "b": "收盤跌破 59,091", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天盤中急漲，重點是尾盤能否守住並收復 MA5 38,312、成交量是否放大；外資若仍賣超代表反彈缺乏籌碼支撐。晚間看消費者信心與標售，明晚核心 PCE 是升息預期的下一關。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "加權趨勢", "text": "加權 11/23 收 36,812，空頭排列，5 日 −10.30%、20 日 −20.05%，乖離 MA5 −3.92%、MA20 −12.89%，距期間高 −26.1%。", "a": "5日 −10.30%／20日 −20.05%", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "mixed", "tag": "美股反彈", "text": "那指 24,090 單日 +6.51%，仍低於 MA10、MA20（空頭排列）；費半 9,588 +14.03%，乖離 MA20 −5.32%，距期間高 −27.5%。", "a": "那指乖離 MA20 −3.63%", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "mixed", "tag": "比特幣", "text": "BTC 11/23 UTC 日收盤 61,270（CoinLore），20 日 −21.79%，乖離 MA20 −12.67%，空頭排列；11/24 盤中約 59,550（−2.6%）；恐懼貪婪 11。", "a": "20日 −21.79%", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "外資與台股", "text": "外資連 6 賣，近 5 日累計 −1,773 億、近 20 日 −10,421 億；加權與費半近 20 日相關係數 0.59。", "a": "近 5 日 −1,773 億", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期約 4.92%（近 5 日 −20bp）；新台幣 32.895 升 4.1 分，近 5 日仍貶 0.9 分；12 月升息機率約 98%。", "a": "10Y 4.92%／TWD 32.895", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "反彈不追價、守紀律", "text": "整體偏保守：反彈雖強但仍屬空頭排列內的技術反彈，開盤大幅跳空不追價；若加權收盤收復 MA5（約 38,312）且外資轉買超，再分批加碼（單次不超過可動用資金 1–2 成）；未收復前以現金為主、不使用融資。", "a": "依據：加權乖離 MA5 −3.92%、MA20 −12.89%，外資連 6 賣；費半單日 +14% 後波動極大。｜今日盤中（11:14）加權約 +9%、仍待收盤確認，操作建議不變。", "b": "風險與失效：收盤跌破 36,033 或 VIX 回升逾 35、核心 PCE 偏高，視為反彈失敗，維持防守。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "VIX、美債 2Y／30Y、布蘭特、金價、BTC／ETH 為單一或衝突來源（盤中、約值、估），已於 snapshot note 標示；BTC UTC 11/23 日收盤、BTC／ETH ETF 單日淨流入、台指期夜盤成交量查不到或僅 2 個來源；AMD、蘋果、微軟價格為由前收與漲幅推算（估）。 本版為盤中版：11/24 台股、BTC、ETH、新台幣為 11:14 盤中約值；新聞子代理查不到過去 24 小時彙整，news 沿用 11/23–24 已查到的內容。", "a": "", "b": "", "url": ""}, {"key": "gap-3", "section": "gap", "ord": 3, "tone": "", "tag": "", "text": "10 月非農、CPI 結果與部分日曆時間（消費者信心、感恩節提早收盤）未核實；FedWatch 98% 為轉述數字。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "自由財經 美股收盤 11/23", "a": "", "b": "", "url": "https://ec.ltn.com.tw/article/breakingnews/5651136"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "中央社 台股收盤 11/23", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611230239.aspx"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "中視／中央社 台股收盤與櫃買", "a": "", "b": "", "url": "https://news.cts.com.tw/cna/money/202611/202611233104268.html"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "中央社 三大法人 11/23", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611230144.aspx"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "中央社 新台幣收盤 11/23", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611230161.aspx"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "經濟日報 台指期夜盤", "a": "", "b": "", "url": "https://money.udn.com/money/story/11112/9897594"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "聯合新聞網 美股 11/23", "a": "", "b": "", "url": "https://udn.com/news/story/6811/9897654"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "CNBC 美債殖利率 11/23", "a": "", "b": "", "url": "https://www.cnbc.com/2026/11/23/treasury-yields-bonds-fed.html"}, {"key": "source-9", "section": "source", "ord": 9, "tone": "", "tag": "", "text": "Finwire 市場回顧 11/23", "a": "", "b": "", "url": "https://finwire.io/news/forex-news/financial-forex-market-recap-nov-23-2026"}, {"key": "source-10", "section": "source", "ord": 10, "tone": "", "tag": "", "text": "CapitalStreet 加密日報 11/23", "a": "", "b": "", "url": "https://www.capitalstreetfx.com/market-analysis/daily-crypto-report-23-nov-2026/"}, {"key": "source-11", "section": "source", "ord": 11, "tone": "", "tag": "", "text": "BLS 12 月日程", "a": "", "b": "", "url": "https://www.bls.gov/schedule/2026/12_sched_list.htm"}]