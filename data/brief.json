[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-22", "text": "週日・假日新聞版（台股休市，行情為 11/20 收盤）", "a": "holiday", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "週一 11/23 起台股實施平盤下全面禁空、融券保證金升至 150%，國安基金傳已進場，但美股 11/20 重挫（那指 −5.3%、費半 −10.7%、台積電 ADR −9.4%）仍是開盤最大壓力。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/23 09:00", "text": "台股週一開盤——禁空新制首日，加權能否守住 36,000／35,739（11/20 盤中低）", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/23 21:45", "text": "美國 11 月 S&P Global flash PMI、2 年期公債標售（時間約略）——物價分項與升息預期", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/24 23:00", "text": "美國 Conference Board 消費者信心（10 月 91.7）；Dell 財報（傳）——AI 伺服器需求", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "11/25 21:30", "text": "美國 Q3 GDP 第二次估值、10 月 PCE／核心 PCE——高於預期則升 2 碼風險升高", "a": "倒數 3 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "11/27 02:00（台灣 11/28）", "text": "美股感恩節 11/26 休市、11/27 提早 13:00 收盤——流動性偏低、波動易放大", "a": "倒數 5 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/1", "text": "黃仁勳赴三個眾議院委員會閉門訪談——輝達治理與晶片走私議題", "a": "倒數 9 天", "b": "", "url": ""}, {"key": "calendar-7", "section": "calendar", "ord": 7, "tone": "", "tag": "12/4 21:30", "text": "美國 11 月非農就業——FOMC 前最後一份就業數據", "a": "倒數 12 天", "b": "", "url": ""}, {"key": "calendar-8", "section": "calendar", "ord": 8, "tone": "", "tag": "12/10 03:00", "text": "FOMC 決議（12/8–9）——升 1 碼約 97.5%，留意升 2 碼與點陣圖；11/CPI 12/10 21:30", "a": "倒數 18 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "上週美國數據偏強：10 月零售 +0.2%、核心 +0.6%，但紐約、費城製造業調查大幅低於預期；10 月 FOMC 紀要顯示 12 月升息 1 碼幾乎確定，部分官員討論升 2 碼。", "a": "", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "台灣", "text": "金管會宣布 11/23 起五項措施：全部 1,986 檔上市櫃股票平盤以下禁空（避險例外）、融券保證金由 130% 升至 150%、暫停受理新認售權證、鼓勵公司買回庫藏股、請金融業暫停出借股票並收回借出股票。", "a": "加權單週跌約 17.5%（36 年來最大），分析師對反彈與否看法分歧。", "b": "", "url": "https://udn.com/news/story/7251/9893828"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "mixed", "tag": "台灣", "text": "傳國安基金已進場護盤；行政院 11/21 召集四個財經部會討論救市。", "a": "週一開盤是政策支撐與美股、ADR 重挫的對決。", "b": "", "url": "https://money.udn.com/money/story/5607/9893976"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "down", "tag": "美股", "text": "美股 11/20 收盤：標普 −3.7% 至 6,910、道瓊 −1.9%（皆進入修正），那指 −5.3% 至 22,618，費半 −10.7%，VIX 35.89 為年內高點；單週標普 −8.6%、那斯達克 100 −10.4%。", "a": "那指為 2020 年以來最差單週，AI 題材持續降溫；10Y 殖利率 −13bp 至 4.92%。", "b": "", "url": "https://finance.yahoo.com/markets/live/stock-market-today-friday-november-19-dow-sp-500-nasdaq-anthropic-nvidia-141644188.html"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "半導體／AI", "text": "輝達 11/20 收 125.53（−14%），單週 −23%，市值蒸發約 2.75 兆美元；黃仁勳 11/12 辭任執行長（Kress 代理），董事會表示不會讓他復職，12/1 將赴國會閉門訪談。SEC 調查一說本次僅單一來源，尚未證實。", "a": "距高點約 48%，供應鏈與台灣 AI 權值承壓。", "b": "", "url": "https://www.aljazeera.com/news/2026/11/21/trump-calls-for-nvidia-to-reinstate-brilliant-jensen-huang"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "mixed", "tag": "半導體／政策", "text": "川普 11/20 記者會說樂見黃仁勳「再給一次機會」，並稱將對在海外建資料中心的美企課徵重關稅。", "a": "輝達董事會不鬆口；關稅威脅增加台灣供應鏈風險。", "b": "", "url": "https://www.aljazeera.com/news/2026/11/21/trump-calls-for-nvidia-to-reinstate-brilliant-jensen-huang"}, {"key": "news-6", "section": "news", "ord": 6, "tone": "down", "tag": "Fed", "text": "10 月 FOMC 紀要顯示幾乎所有官員預期 12 月升息 1 碼，部分人提到升 2 碼；CME FedWatch 12 月升 1 碼機率約 97.5%。", "a": "10Y 殖利率單週 −24bp 至 4.92%，黃金單週約 −8.9%，顯示全面去槓桿。", "b": "", "url": "https://theglassdesk.substack.com/p/weekly-market-review-nov-20-2026"}, {"key": "news-7", "section": "news", "ord": 7, "tone": "down", "tag": "加密", "text": "BTC 11/20 週收約 58,799（週 −13.9%）、ETH 約 1,619（−16.0%）；BTC 現貨 ETF 近 7 個交易日流出約 19 億美元。週末即時報價未查到。", "a": "加密與科技股同步下殺。", "b": "", "url": "https://theglassdesk.substack.com/p/weekly-market-review-nov-20-2026"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 5 賣、近 5 日累計 −2,186 億，期貨淨空約 9.8 萬口；自營商避險賣壓 290 億是今日最大單一賣壓，投信也轉賣。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝雲端資安概念；弱勢＝半導體／AI 供應鏈、ABF 載板、PCB、散熱、CPO", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "美股 AI 股走弱與升息預期傳導到台股權值，再被期貨與避險賣壓放大成恐慌殺盤。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 外資是否止賣 (2) 10Y 是否站穩 5% (3) 12/10 FOMC 與 11/25 PCE (4) 金管會限空措施成效", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "國安基金表態護盤、金管會限空新制；若美股今晚止跌，下週一有跌深技術反彈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期→殖利率 5%→AI 估值下修→外資與自營商避險賣壓→368 檔跌停→流動性風險。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "日股早盤 −4.5%、韓股 −3.5%，亞股同步重挫；美股期貨與台指期夜盤收盤未查到。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "今晚美東 11/20 美股；11/23 台股週一開盤；11/25 PCE。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：國安基金與限空新制托底、乖離 MA20 −15.7% 極度超跌 vs 空方疑慮：外資連 5 賣、期貨空單約 9.8 萬口、跌停潮造成流動性風險", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "週末美股 11/20 大跌後的連動。多方推演→限空新制與國安基金週一奏效、技術反彈；空方推演→美股重挫（那指 −5.28%）＋輝達 −14% 衝擊 AI 供應鏈，週一續殺、跌停潮延續", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：35,739（今日盤中低）支撐、36,000 整數關卡、39,157（MA5）壓力、39,368 年線；費半 9,011（期間低）", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤再跌破 35,739（今日盤中低）", "a": "收復 MA5 39,157", "b": "觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "10Y 殖利率收盤站上 5.15% 或 FedWatch 升 50 bp 機率逾 25%", "a": "10Y 回到 5.0% 以下", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "外資單日賣超逾 1,000 億或加權單日再跌逾 3%", "a": "外資連 2 日買超", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收復 39,157（MA5）且外資轉買→反彈可延伸至 40,686–42,000", "a": "外資單日買超、成交量放大", "b": "再度收低於 36,000", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若 11/25 核心 PCE 高於預期→升 50 bp 機率上升，風險資產再下修", "a": "核心 PCE 月增 ≥0.4%、10Y 破 5.15%", "b": "核心 PCE 低於預期、殖利率回落", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若費半跌破 9,011（期間低）→台積電與 AI 供應鏈續弱", "a": "費半收盤低於 9,011", "b": "費半收復 9,694（MA5）", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "週一開盤前盯：美股期貨與台積電 ADR 能否止跌、禁空新制與國安基金是否撐住加權 35,739（11/20 盤中低）與 36,000。11/25 核心 PCE 是 12 月升 2 碼風險的關鍵。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "台股", "text": "加權 −6.23% 收 36,033.29，5 日 −17.50%、20 日 −23.15%，MA20 乖離 −15.65%、空頭排列，距期間高 −27.7%。", "a": "外資近 5 日累計 −2,186 億；成交值約 8,788 億", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股", "text": "那指 −2.25% 收 23,879.20、費半 −2.42% 收 9,419.72，均創區間新低、空頭排列；加權與費半 20 日相關係數 0.49。", "a": "費半距高點 −28.7%；VIX 28.4（+15.8%）", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "加密", "text": "BTC 11/19 UTC 收 62,007，20 日 −19.8%、距高點 −27.5%，乖離 MA20 −13.8%；現貨約 61,842，恐懼貪婪 12（極度恐懼）。", "a": "空頭排列；BTC ETF 11/13 當週 −10.7 億美元", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "mixed", "tag": "利率", "text": "10Y 約 5.05%，近 5 日 −8 bp 但仍在高檔；紀要偏鷹，市場多已計入 12 月升 25 bp。", "a": "30Y 5.401%；2Y 11/19 未查到", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "匯率", "text": "新台幣 Yahoo 即時約 32.969，近 5 日貶約 13 分，外資連賣是貶值壓力來源。", "a": "非 16:00 官方收盤", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "嚴控風險、不接刀", "text": "加權 5 日 −17.5%、乖離 MA20 −15.7%，崩跌期間不攤平、不借錢進場；現金維持高比重。若加權收復 39,157（MA5）且外資轉買，才以小部位分批試單，目標 40,686–42,000；若收盤再破 35,739 則續降部位。", "a": "依據：加權單週 −17.5%、368 檔跌停、外資連 5 賣、期貨淨空約 9.8 萬口", "b": "風險：跌深反彈可能很快、也可能因流動性不足續殺；PCE／FOMC 偏鷹會再壓估值。本建議為情境分析，不保證獲利。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "假日版：美股 11/20 收盤與 BTC 週收為單一來源；週末 BTC／ETH 即時報價、美股期貨、台積電 11 月營收日期、台灣央行會議日期未查到。", "a": "", "b": "", "url": ""}, {"key": "gap-2", "section": "gap", "ord": 2, "tone": "", "tag": "", "text": "輝達 SEC 調查本次未獲第二來源證實；黃仁勳請辭、Dell 財報日、國安基金進場皆為媒體報導／傳聞，PCE 發布時間 21:30 未經官方確認。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "UDN 金管會禁空五項措施", "a": "", "b": "", "url": "https://udn.com/news/story/7251/9893828"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "UDN 國安基金與救市會議", "a": "", "b": "", "url": "https://money.udn.com/money/story/5607/9893976"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "Yahoo Finance 美股 11/20 收盤", "a": "", "b": "", "url": "https://finance.yahoo.com/markets/live/stock-market-today-friday-november-19-dow-sp-500-nasdaq-anthropic-nvidia-141644188.html"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "Al Jazeera 川普與輝達", "a": "", "b": "", "url": "https://www.aljazeera.com/news/2026/11/21/trump-calls-for-nvidia-to-reinstate-brilliant-jensen-huang"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "Glass Desk 週回顧 11/20", "a": "", "b": "", "url": "https://theglassdesk.substack.com/p/weekly-market-review-nov-20-2026"}]