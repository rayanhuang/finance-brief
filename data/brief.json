[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-25", "text": "週三・早報（台股 11/24 收盤、美股 11/24 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "mixed", "tag": "", "text": "台股 11/24 單日大漲 3,310 點（+8.99%）收 40,122，創史上最大漲點，但成交僅 4,194 億（今年最低）、外資連 7 賣 504 億；美股費半隔夜 −7.88% 回吐，今晚核心 PCE 與 12/9 升息機率 97% 是下一關。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/25 21:30", "text": "美國 10 月核心 PCE（預期月增 0.3%、年增 3.2%）、Q3 GDP 二次估值（預期 3.5%）、初領失業救濟金、耐久財訂單——升息預期的關鍵數據", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "11/26 03:00", "text": "Fed 褐皮書——各地區物價與就業描述，影響升息預期", "a": "倒數 1 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "11/27 全天", "text": "美股感恩節休市（11/28 02:00 台北時間提前收盤）——美股量縮、台股隔日缺乏美股指引", "a": "倒數 2 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/04 21:30", "text": "美國 11 月非農就業——就業降溫與否決定 12 月升息力道", "a": "倒數 9 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/10 03:00", "text": "FOMC 決議（12/8–9 會議，依慣例推算、未驗證）——升息 25bp 機率約 97%，看點陣圖與談話", "a": "倒數 15 天", "b": "", "url": ""}, {"key": "calendar-6", "section": "calendar", "ord": 6, "tone": "", "tag": "12/10 前後", "text": "台積電 11 月營收（依慣例推估、非官方）——10 月營收 5,869 億元、年增 59.7%，看 AI 需求是否延續", "a": "倒數 15 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "", "text": "美國 11 月消費者信心（11/24 23:00 公布）實際值未查到（預期 92.1、前值 91.7）；台股 11/24 收盤創史上最大漲點，美股費半隔夜回吐 7.88%。", "a": "消費者信心實際值缺", "b": "", "url": ""}, {"key": "news-1", "section": "news", "ord": 1, "tone": "up", "tag": "台股大盤", "text": "台股 11/24 收 40,122.35 點、漲 3,310.46 點（+8.99%），創史上收盤最大漲點，成交值約 4,194 億為今年最低，台積電 2,230 元漲停、上市櫃逾 600 檔漲停。", "a": "外資賣超 503.9 億、連 7 賣，三大法人合計賣超約 1,217 億，內資承接、量縮上攻。", "b": "https://www.cna.com.tw/news/afe/202611240131.aspx", "url": ""}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "美股／半導體", "text": "美股 11/24 費半 −7.88% 收 8,832.50、輝達回落 5.86%（前日因黃仁勳回任大漲逾 31%）、Anthropic 收 81.9 美元跌破發行價；傳川普政府將公布對 16 個貿易夥伴的產能過剩調查、擬加徵關稅。", "a": "AI 概念股獲利回吐，道瓊 +0.85% 收復 5 萬點，那指 −1.48%、標普 −0.50%。", "b": "https://www.moneydj.com/kmdj/news/newsviewer.aspx?a=2e86e122-e47d-48cb-91dc-03b00ed6d8f9", "url": ""}, {"key": "news-3", "section": "news", "ord": 3, "tone": "down", "tag": "Fed／宏觀", "text": "CME FedWatch 顯示 12/9 升息 25bp 機率 97.2%（前值 96.3%），升息 50bp 機率降至 2.8%；10 月核心 PCE 今晚公布。", "a": "市場觀望 PCE，美股盤面偏防守。", "b": "https://www.moneydj.com/kmdj/news/newsviewer.aspx?a=2e86e122-e47d-48cb-91dc-03b00ed6d8f9", "url": ""}, {"key": "news-4", "section": "news", "ord": 4, "tone": "down", "tag": "匯率", "text": "新台幣 11/24 收 32.939、貶 4.4 分，盤中一度觸 33 元，成交 34.88 億美元；美元指數站上 104。", "a": "股匯罕見脫鉤：股市大漲但外資賣股匯出，亞幣承壓。", "b": "https://www.cna.com.tw/news/afe/202611240255.aspx", "url": ""}, {"key": "news-5", "section": "news", "ord": 5, "tone": "up", "tag": "台積電供應鏈", "text": "台積電稱 AI 需求持續增加、先進製程產能供不應求；美國擴廠由亞利桑那延伸至德州，法人預期台灣供應鏈分三階段受惠（廠務工程、製程化學氣體、設備搬運）。", "a": "全文未報個股漲跌；提醒零組件漲價與總經不確定性對消費性終端有挑戰。", "b": "https://www.ctee.com.tw/news/20261125700062-430501", "url": ""}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 7 賣（11/24 −503.9 億，近 5 日 −1,896 億），但投信 +97.6 億、內資承接，量縮至 4,194 億，屬「少量資金推升」的急漲，續航力待量能確認。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝機電（+9.47%）、金融（+8.74%）、塑化（+7.7%）、營建（+5.0%）；弱勢＝11/24 全面上漲、無明顯弱勢族群，但隔夜美股費半 −7.88%，半導體權值今日承壓風險最高。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "超跌反彈已把加權推回 MA10（40,375）附近，但外資未回頭、量縮、隔夜費半重挫，今天比的是反彈能不能守住而非追價。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 加權能否守住 MA5 38,318；(2) 外資是否由賣轉買、成交量是否回到 6,000 億以上；(3) 今晚核心 PCE 對 12/9 升息預期的影響；(4) VIX 是否回升至 35 以上。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "超跌後的技術反彈加上資金回流機電、金融等內需權值，加權收復 MA5（38,318）並逼近 MA10（40,375）；若 PCE 持平或偏低，升息預期降溫可延伸反彈。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "費半隔夜 −7.88%、輝達與 AI 供應鏈回吐，傳導至台積電、聯發科等權值；外資連 7 賣、新台幣貶破 32.9，若美元續強可能引發外資再度匯出。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "加權與費半近 20 日相關係數 0.31、與那指 0.46，連動較先前降低；但今日美股半導體重挫，需檢核台股開盤是否跟跌。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "11/25 21:30 核心 PCE；11/27 美股感恩節休市、11/28 提前收盤，台股 11/27 失去隔夜美股指引。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：史上最大漲點、收復 MA5、投信買超、跌深反彈 vs 空方疑慮：外資連 7 賣、量縮至今年最低、升息 97% 定價、費半隔夜 −7.88%、均線仍空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "11/25 21:30 核心 PCE。多方推演→PCE 持平或偏低、升息預期降溫，加權站穩 MA10 40,375；空方推演→PCE 偏高、升息論調增強，反彈在 40,375～41,959（MA20）受壓並回測 38,318。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 38,318（MA5）、36,033（11/20 低）；壓力 40,375（MA10）、41,959（MA20）。那指壓力 24,356（MA10）；費半支撐 8,409（11/20 低）。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 36,033", "a": "收復 MA5 38,318 並站穩", "b": "未觸發", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超逾 300 億且連 7 賣", "a": "外資轉買超", "b": "觸發", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "VIX 回升至 35 以上或費半跌破 8,409", "a": "VIX 回到 25 以下", "b": "觀察中", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權守住 MA5 38,318 且量能回升→ 反彈可挑戰 MA10 40,375 與 MA20 41,959", "a": "外資賣超縮至 100 億內、電子權值續強", "b": "收盤跌回 38,318 下", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若核心 PCE 高於預期→ 殖利率與美元走強、成長股估值承壓，台股回測 38,000 附近", "a": "10 年期上升逾 5bp、DXY 突破 104.5", "b": "殖利率回落、DXY 回到 103.5 下", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若比特幣守住 59,091（11/20 低）→ 區間 59–65k 震盪", "a": "恐懼貪婪回升至 20 以上、ETF 轉淨流入", "b": "收盤跌破 59,091", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天最該盯的是反彈能否守住：加權守 38,318、外資是否仍賣超，以及費半隔夜 −7.88% 對半導體權值的拖累。晚上核心 PCE 與 GDP 二次估值是升息預期的關鍵，結果出來前不宜追價。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "mixed", "tag": "加權趨勢", "text": "加權 11/24 收 40,122，5 日 +0.08%、20 日 −12.96%，乖離 MA5 +4.71%、MA10 −0.62%、MA20 −4.38%，空頭排列，距期間高 −19.5%。", "a": "5日 +0.08%／20日 −12.96%", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "美股回吐", "text": "那指 23,734 單日 −1.48%，乖離 MA20 −4.53%、空頭排列；費半 8,833 單日 −7.88%，乖離 MA20 −11.63%，距期間高 −33.2%。", "a": "費半乖離 MA20 −11.63%", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "down", "tag": "比特幣", "text": "BTC 11/24 約 59,723（Yahoo 約值，−2.43%），20 日 −22.26%，乖離 MA20 −13.83%，空頭排列；恐懼貪婪 11（極度恐懼）。", "a": "20日 −22.26%", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "外資與台股", "text": "外資連 7 賣，近 5 日累計 −1,896 億、近 20 日 −10,844 億；加權與費半近 20 日相關係數 0.31。", "a": "近 5 日 −1,896 億", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "mixed", "tag": "利率匯率", "text": "10 年期約 4.90%（近 5 日 −20bp）；新台幣 32.939 貶 4.4 分，近 5 日貶 8.9 分；12 月升息機率約 97.2%。", "a": "10Y 4.90%／TWD 32.939", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "mixed", "tag": "不追價、站穩再說", "text": "整體偏保守：加權雖收復 MA5，但外資連 7 賣、量縮、隔夜費半 −7.88%，反彈不追價；若加權收盤站上 MA10（約 40,375）且外資轉買超，再分批加碼（單次不超過可動用資金 1–2 成）；未達成前以現金為主、不使用融資。", "a": "依據：加權乖離 MA5 +4.71%、MA20 −4.38%，外資連 7 賣；成交值 4,194 億為今年最低，急漲缺量能。", "b": "風險與失效：收盤跌破 MA5 38,318、核心 PCE 偏高或 VIX 回升逾 35，視為反彈失敗，維持防守。", "url": ""}, {"key": "gap-1", "section": "gap", "ord": 1, "tone": "", "tag": "", "text": "台指期夜盤、櫃買指數、美債 2Y、BTC 11/24 UTC 日收盤（採 Yahoo 約值）、BTC／ETH ETF 單日淨流入、企業國庫動向查不到；成交值有 4,194／4,203／4,268 億三種口徑，採中央社；三大法人採證交所（中央社投信 +84.04、合計 −1,230.11 與之略有差異）；國際新聞僅 MoneyDJ 單一來源，Fed 官員發言、能源、加密新聞未查到；AMD 漲幅原因未載；11/24 消費者信心實際值、FOMC 與台積電營收日期為推算。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "中央社 台股收盤 11/24", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611240131.aspx"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "中央社 新台幣收盤 11/24", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611240255.aspx"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "經濟日報 台股史上最大漲點", "a": "", "b": "", "url": "https://www.ctee.com.tw/news/20261124701845-430204"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "MoneyDJ 美股 11/24 收盤", "a": "", "b": "", "url": "https://www.moneydj.com/kmdj/news/newsviewer.aspx?a=2e86e122-e47d-48cb-91dc-03b00ed6d8f9"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "鉅亨網 美股收盤 11/24", "a": "", "b": "", "url": "https://news.cnyes.com/news/id/6671173"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "工商時報 台積電美國擴廠", "a": "", "b": "", "url": "https://www.ctee.com.tw/news/20261125700062-430501"}, {"key": "source-7", "section": "source", "ord": 7, "tone": "", "tag": "", "text": "中央社 台積電 AI 需求", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611230175.aspx"}, {"key": "source-8", "section": "source", "ord": 8, "tone": "", "tag": "", "text": "Gotrade 本週經濟展望", "a": "", "b": "", "url": "https://www.heygotrade.com/en/news/weekly-economic-outlook-2026-11-23/"}, {"key": "source-9", "section": "source", "ord": 9, "tone": "", "tag": "", "text": "CoinLore BTC 歷史", "a": "", "b": "", "url": "https://www.coinlore.com/coin/bitcoin/historical-data"}, {"key": "source-10", "section": "source", "ord": 10, "tone": "", "tag": "", "text": "Yahoo Finance、證交所、alternative.me（程式抓取）", "a": "", "b": "", "url": "https://finance.yahoo.com"}]