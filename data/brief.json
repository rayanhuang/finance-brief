[{"key": "meta-1", "section": "meta", "ord": 1, "tone": "", "tag": "2026-11-19", "text": "週四・早報（台股 11/18 收盤、美股 11/18 收盤）", "a": "", "b": "", "url": ""}, {"key": "take-1", "section": "take", "ord": 1, "tone": "", "tag": "", "text": "Fed 紀要暗示可能進一步升息、美元創 19 個月高，加權小漲 0.26% 收 40,195 但外資連 3 日賣超、新台幣貶至新低；今晚 Anthropic 掛牌是 AI 風險偏好的檢驗。", "a": "", "b": "", "url": ""}, {"key": "calendar-1", "section": "calendar", "ord": 1, "tone": "", "tag": "11/19 22:30", "text": "Anthropic（ANT）掛牌首日——定價是否高於 70–78 美元區間、AI 風險偏好", "a": "今天", "b": "", "url": ""}, {"key": "calendar-2", "section": "calendar", "ord": 2, "tone": "", "tag": "12/04 21:30", "text": "美國 11 月非農——薪資與失業率對升息路徑的影響（日期待確認）", "a": "倒數 15 天", "b": "", "url": ""}, {"key": "calendar-3", "section": "calendar", "ord": 3, "tone": "", "tag": "12/10 03:00", "text": "FOMC 利率決議——升息幅度、點陣圖與記者會", "a": "倒數 21 天", "b": "", "url": ""}, {"key": "calendar-4", "section": "calendar", "ord": 4, "tone": "", "tag": "12/10 21:30", "text": "美國 11 月 CPI——核心通膨是否降溫", "a": "倒數 21 天", "b": "", "url": ""}, {"key": "calendar-5", "section": "calendar", "ord": 5, "tone": "", "tag": "12/23 21:30", "text": "美國 Q3 GDP 三次估值＋11 月 PCE——Fed 偏好通膨指標", "a": "倒數 34 天", "b": "", "url": ""}, {"key": "landed-1", "section": "landed", "ord": 1, "tone": "", "tag": "Fed 10 月紀要", "text": "幾乎所有官員認為若通膨與勞動市場如預期，可能需進一步升息；兩位官員願在通膨惡化時 12 月升息逾 25 bp。美元升至 19 個月高、10Y 約 5.10%、金價大跌。確切升息機率未取得。", "a": "", "b": "", "url": "https://www.fool.com/coverage/stock-market-today/2026/11/18/stock-market-today-nov-18-s-and-p-500-breaks-key-support-as-fed-minutes-signal-more-rate-hikes-ahead/"}, {"key": "news-1", "section": "news", "ord": 1, "tone": "down", "tag": "Fed", "text": "Fed 紀要偏鷹，官員傾向進一步升息", "a": "美元 19 個月高、10Y 約 5.10%、黃金 -3.5%", "b": "", "url": "https://www.fool.com/coverage/stock-market-today/2026/11/18/stock-market-today-nov-18-s-and-p-500-breaks-key-support-as-fed-minutes-signal-more-rate-hikes-ahead/"}, {"key": "news-2", "section": "news", "ord": 2, "tone": "down", "tag": "宏觀", "text": "美股 11/18：S&P 500 -0.23% 收 7,323.63（五連跌、跌破 200 日線）、道瓊 -1.11%、那指 +0.42%，VIX 24.49", "a": "聯合健康、Humana 因新規重挫拖累道瓊", "b": "", "url": "https://vistapglobal.com/u-s-stock-market-today-november-18-2026-dow-falls-561-points-nasdaq-rises-ahead-of-anthropic-ipo-ant-eprx-googl-modd-nvda-ser-tgt/"}, {"key": "news-3", "section": "news", "ord": 3, "tone": "mixed", "tag": "半導體/AI", "text": "輝達財報營收年增 103%，但已停止對中國 Hopper 出貨，預期未來無中國營收", "a": "早盤漲幅回吐，收 150.96 美元 -2.89%", "b": "", "url": "https://vistapglobal.com/u-s-stock-market-today-november-18-2026-dow-falls-561-points-nasdaq-rises-ahead-of-anthropic-ipo-ant-eprx-googl-modd-nvda-ser-tgt/"}, {"key": "news-4", "section": "news", "ord": 4, "tone": "up", "tag": "AI/IPO", "text": "Anthropic（ANT）擬發 8.25 億股、區間 70–78 美元，台北 11/19 晚間掛牌（擬議條件，傳可能高於區間定價）", "a": "那指逆勢收漲，AI 題材偏多", "b": "", "url": "https://vistapglobal.com/u-s-stock-market-today-november-18-2026-dow-falls-561-points-nasdaq-rises-ahead-of-anthropic-ipo-ant-eprx-googl-modd-nvda-ser-tgt/"}, {"key": "news-5", "section": "news", "ord": 5, "tone": "down", "tag": "加密", "text": "比特幣收約 62,446 美元，報導稱 Fed 紀要壓抑風險資產", "a": "高利率環境下承壓", "b": "", "url": "https://cryptoticker.io/en/bitcoin-price-prediction-fed-minutes-november-18-2026"}, {"key": "news-6", "section": "news", "ord": 6, "tone": "down", "tag": "台股", "text": "加權收 40,194.91（+0.26%），外資賣超 765.63 億、台積電被調節逾 1.5 萬張；金融 -3.22%、塑膠 -2.53%", "a": "新台幣貶 9.7 分至 32.947，創逾 19 個月新低", "b": "", "url": "https://www.cna.com.tw/news/afe/202611180143.aspx"}, {"key": "insight-1", "section": "insight", "ord": 1, "tone": "", "tag": "資金流向", "text": "外資連 3 日賣超（11/18 -765.63 億，近 5 日 -1,567 億），投信 +175.58 億承接；新台幣貶至新低與外資賣超互相強化。", "a": "", "b": "", "url": ""}, {"key": "insight-2", "section": "insight", "ord": 2, "tone": "", "tag": "板塊輪動", "text": "強勢＝機械（+0.86%）；弱勢＝金融（-3.22%）、塑膠、水泥。", "a": "", "b": "", "url": ""}, {"key": "insight-3", "section": "insight", "ord": 3, "tone": "", "tag": "一句話", "text": "升息預期推升殖利率與美元→壓抑成長股估值與外資部位→新台幣貶、台股權值承壓。", "a": "", "b": "", "url": ""}, {"key": "insight-4", "section": "insight", "ord": 4, "tone": "", "tag": "觀察指標", "text": "(1) 10Y 殖利率是否續高於 5.1%；(2) 外資是否轉買；(3) 新台幣 33 關卡；(4) ANT 掛牌後那指反應。", "a": "", "b": "", "url": ""}, {"key": "tw-1", "section": "tw", "ord": 1, "tone": "up", "tag": "利多傳導", "text": "ANT 若高於區間定價且首日走強→AI 風險偏好回升→台灣 AI 供應鏈跟漲。", "a": "", "b": "", "url": ""}, {"key": "tw-2", "section": "tw", "ord": 2, "tone": "down", "tag": "風險傳導", "text": "升息預期＋美元強→外資持續提款、新台幣貶→權值股承壓。", "a": "", "b": "", "url": ""}, {"key": "tw-3", "section": "tw", "ord": 3, "tone": "check", "tag": "海外連動檢核", "text": "那指 +0.42% 與道瓊 -1.11% 分歧；費半 11/18 未取得，台股開盤方向以夜盤與費半為準。", "a": "", "b": "", "url": ""}, {"key": "tw-4", "section": "tw", "ord": 4, "tone": "check", "tag": "特殊日程", "text": "今晚 ANT 掛牌；本週多位 Fed 官員談話（時間未確認）。", "a": "", "b": "", "url": ""}, {"key": "board-1", "section": "board", "ord": 1, "tone": "", "tag": "核心矛盾", "text": "多方力量：加權守住 4 萬點、投信承接、那指逆勢收紅 vs 空方疑慮：Fed 升息預期、外資連賣、新台幣創新低、均線空頭排列。", "a": "", "b": "", "url": ""}, {"key": "board-2", "section": "board", "ord": 2, "tone": "", "tag": "最重要事件", "text": "ANT 掛牌。多方推演→定價高於區間、首日走強，AI 情緒回溫；空方推演→定價或首日表現弱，加上升息預期，資金續撤。", "a": "", "b": "", "url": ""}, {"key": "board-3", "section": "board", "ord": 3, "tone": "", "tag": "關鍵價位", "text": "加權：支撐 39,701（期間低）、壓力 41,619（MA5）／43,656（MA20）；新台幣 33.0。", "a": "", "b": "", "url": ""}, {"key": "alert-1", "section": "alert", "ord": 1, "tone": "", "tag": "L1", "text": "加權收盤跌破 39,701（期間低）", "a": "收復 MA5 41,619", "b": "觀察中", "url": ""}, {"key": "alert-2", "section": "alert", "ord": 2, "tone": "", "tag": "L2", "text": "外資單日賣超逾 800 億", "a": "外資轉買超", "b": "觀察中", "url": ""}, {"key": "alert-3", "section": "alert", "ord": 3, "tone": "", "tag": "L3", "text": "美 10Y 殖利率升破 5.2%", "a": "回落至 5.0% 以下", "b": "未觸發", "url": ""}, {"key": "trigger-1", "section": "trigger", "ord": 1, "tone": "", "tag": "", "text": "若加權收復 41,619 且外資轉買→反彈可延伸至 43,000 附近", "a": "外資單日買超、成交量放大", "b": "再度跌回 41,000 下", "url": ""}, {"key": "trigger-2", "section": "trigger", "ord": 2, "tone": "", "tag": "", "text": "若加權跌破 39,701→空頭加速，下檔看 39,000 以下", "a": "外資續賣超＋新台幣貶破 33", "b": "外資轉買、跌幅收斂", "url": ""}, {"key": "trigger-3", "section": "trigger", "ord": 3, "tone": "", "tag": "", "text": "若 10Y 升破 5.2%→成長股估值再壓縮，科技權值承壓", "a": "美元續強、那指跌破 24,315", "b": "殖利率回落至 5.0% 以下", "url": ""}, {"key": "focus-1", "section": "focus", "ord": 1, "tone": "", "tag": "", "text": "今天盯三件事：開盤後外資是否續賣、新台幣是否貶破 33、今晚 ANT 掛牌表現。", "a": "", "b": "", "url": ""}, {"key": "analysis-1", "section": "analysis", "ord": 1, "tone": "down", "tag": "大盤", "text": "加權空頭排列：收 40,195，5 日 -9.18%、20 日 -14.15%，距 MA20 -7.9%，距期間高 -19.3%；但守住期間低 39,702 上方。", "a": "MA5 41,619／MA20 43,656", "b": "", "url": ""}, {"key": "analysis-2", "section": "analysis", "ord": 2, "tone": "down", "tag": "籌碼", "text": "外資連 3 日賣超，近 5 日累計 -1,567 億、近 20 日 -11,396 億；投信 11/18 買超 175.58 億。", "a": "-765.63 億", "b": "", "url": ""}, {"key": "analysis-3", "section": "analysis", "ord": 3, "tone": "mixed", "tag": "美股", "text": "那指 24,430 仍低於 MA20（-3.7%），20 日 -8.5%；S&P 500 五連跌。", "a": "那指 MA20 25,375", "b": "", "url": ""}, {"key": "analysis-4", "section": "analysis", "ord": 4, "tone": "down", "tag": "BTC", "text": "比特幣約 62,446，5 日 -9.4%、20 日 -19.9%，貼近期間低、空頭排列。", "a": "MA20 72,704", "b": "", "url": ""}, {"key": "analysis-5", "section": "analysis", "ord": 5, "tone": "down", "tag": "利率匯率", "text": "10Y 5.10%，近 5 日 +11 bp；新台幣 32.947，近 5 日貶 8.7 分，創逾 19 個月新低。", "a": "33.0 關卡", "b": "", "url": ""}, {"key": "advice-1", "section": "advice", "ord": 1, "tone": "down", "tag": "防守觀望、不追價", "text": "整體部位維持偏低，不在空頭排列中攤平；加權站回 MA5 41,619 且外資轉買再分批回補；若收盤跌破 39,701 再降低風險部位。", "a": "加權空頭排列、外資連賣、升息預期推升殖利率與美元", "b": "升息預期若降溫或 ANT 帶動 AI 風險偏好回升，可能快速反彈；以上為條件式情境，非獲利保證", "url": ""}, {"key": "gap-3", "section": "gap", "ord": 3, "tone": "", "tag": "", "text": "行情 API 連不上，改用搜尋：費半、台積電、聯發科、櫃買、台指期夜盤、美債 2Y／30Y、布蘭特、DXY、ETH、恐懼貪婪、ETF 淨流入皆未取得。", "a": "", "b": "", "url": ""}, {"key": "gap-4", "section": "gap", "ord": 4, "tone": "", "tag": "", "text": "BTC 62,446 為約值非 UTC 收盤；10Y 5.10 與黃金 -3.51%（另一來源 -2.38%）為約值；非農日期待確認；Fed 12 月升息機率未取得。", "a": "", "b": "", "url": ""}, {"key": "source-1", "section": "source", "ord": 1, "tone": "", "tag": "", "text": "Motley Fool 11/18 市場報導", "a": "", "b": "", "url": "https://www.fool.com/coverage/stock-market-today/2026/11/18/stock-market-today-nov-18-s-and-p-500-breaks-key-support-as-fed-minutes-signal-more-rate-hikes-ahead/"}, {"key": "source-2", "section": "source", "ord": 2, "tone": "", "tag": "", "text": "Vista Global 美股 11/18", "a": "", "b": "", "url": "https://vistapglobal.com/u-s-stock-market-today-november-18-2026-dow-falls-561-points-nasdaq-rises-ahead-of-anthropic-ipo-ant-eprx-googl-modd-nvda-ser-tgt/"}, {"key": "source-3", "section": "source", "ord": 3, "tone": "", "tag": "", "text": "中央社 台股 11/18 收盤", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611180143.aspx"}, {"key": "source-4", "section": "source", "ord": 4, "tone": "", "tag": "", "text": "中央社 三大法人 11/18", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611180187.aspx"}, {"key": "source-5", "section": "source", "ord": 5, "tone": "", "tag": "", "text": "中央社 新台幣 11/18 收盤", "a": "", "b": "", "url": "https://www.cna.com.tw/news/afe/202611180215.aspx"}, {"key": "source-6", "section": "source", "ord": 6, "tone": "", "tag": "", "text": "CryptoTicker BTC 11/18", "a": "", "b": "", "url": "https://cryptoticker.io/en/bitcoin-price-prediction-fed-minutes-november-18-2026"}]